    },
    {
      "id": "eLjVJTTw-O2WlzbO4BgoA",
      "type": "text",
      "x": 3620.103693895393,
      "y": 1691.630809662114,
      "width": 1517.6666259765625,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9K",
      "roundness": null,
      "seed": 358119732,
      "version": 380,
      "versionNonce": 1508167858,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1769298935722,
      "link": null,
      "locked": false,
      "text": "Por la estructura de los Algoritmos, y debido a que recorren los vértices una sola vez \na cada uno, de forma tal que no se agregan vértices que ya estaban en W\npor nede, se previenen los Ciclos; Las componentes conexas que resulten\nserán ARBOLES",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por la estructura de los Algoritmos, y debido a que recorren los vértices una sola vez \na cada uno, de forma tal que no se agregan vértices que ya estaban en W\npor nede, se previenen los Ciclos; Las componentes conexas que resulten\nserán ARBOLES",
      "autoResize": true,
      "lineHeight": 1.25
    },
