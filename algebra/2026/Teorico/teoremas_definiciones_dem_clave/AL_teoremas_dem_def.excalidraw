    {
      "id": "AcxRu0p-n_HK6NQJP5QXV",
      "type": "ellipse",
      "x": -713.4071367671241,
      "y": 1002.2568071020858,
      "width": 209.63633872610433,
      "height": 90.78739078689546,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
