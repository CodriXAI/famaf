    {
      "id": "YzEqEKdPGzeYDd4sfTiRZ",
      "type": "text",
      "x": 2009.771664626437,
      "y": 1542.3180011726308,
      "width": 1647.8499755859375,
      "height": 1395,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
