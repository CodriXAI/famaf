    {
      "id": "YecxlMGfuQcvRH9wR7-5L",
      "type": "text",
      "x": 1037.5006841787595,
      "y": 1140.2716512076556,
      "width": 1136.816650390625,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
