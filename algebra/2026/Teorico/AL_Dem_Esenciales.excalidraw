      "locked": false
    },
    {
      "id": "tHjwlzCnU3pLJkD9HRCij",
      "type": "text",
      "x": 9216.839169260984,
      "y": 10417.87532308003,
      "width": 1514.4832763671875,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "NXkdyAx3ZVT6ub2Sn7UrI",
      "index": "bJq",
      "roundness": null,
      "seed": 582371813,
      "version": 217,
      "versionNonce": 224841189,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776551713415,
      "link": null,
      "locked": false,
      "text": "Supongamos A ∈ Rn×n (matriz cuadrada). Son equivalentes:\n\n    1) A es invertible (existe A⁻¹).\n\n    2) det(A) != 0.\n\n    3) El sistema homogéneo Ax=0 tiene solución única (la trivial x=0).\n\n    4) A es equivalente por filas a la identidad In​ (puedes llegar a In​ mediante Gauss).",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Supongamos A ∈ Rn×n (matriz cuadrada). Son equivalentes:\n\n    1) A es invertible (existe A⁻¹).\n\n    2) det(A) != 0.\n\n    3) El sistema homogéneo Ax=0 tiene solución única (la trivial x=0).\n\n    4) A es equivalente por filas a la identidad In​ (puedes llegar a In​ mediante Gauss).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mWCw2crzYjvoaCoih8Rey",
      "type": "text",
      "x": 9233.828059167128,
      "y": 10906.077570271043,
      "width": 96.02709008803187,
      "height": 53.464419475655205,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "NXkdyAx3ZVT6ub2Sn7UrI",
      "index": "bJr",
      "roundness": null,
      "seed": 1872874821,
      "version": 1245,
      "versionNonce": 2074160875,
