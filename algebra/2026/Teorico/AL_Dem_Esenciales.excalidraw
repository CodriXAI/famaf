    {
      "id": "GLLbRGkdfRrVUSStuN5Dy",
      "type": "text",
      "x": 9209.676094828408,
      "y": 15216.34770645177,
      "width": 1192.449951171875,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
