    {
      "id": "ZqrOJIVu9VZ0a75z-ZS64",
      "type": "text",
      "x": 138.98096275208297,
      "y": 11823.612870247847,
      "width": 1276.88330078125,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
