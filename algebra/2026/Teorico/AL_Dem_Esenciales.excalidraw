      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "XT-hu42di65RdmmLYu5Ys",
      "index": "bBf",
      "roundness": null,
      "seed": 2076014287,
      "version": 639,
