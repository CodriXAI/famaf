    {
      "id": "Iu8ed4bCkXSfQBxy1O69G",
      "type": "text",
      "x": 4761.591041735048,
      "y": 13865.864946221473,
      "width": 967.0833129882812,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
