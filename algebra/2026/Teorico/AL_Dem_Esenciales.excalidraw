    {
      "id": "D9van2Uvw26gmyH3P6q_k",
      "type": "text",
      "x": 143.66747068859138,
      "y": 10275.81128294626,
      "width": 1296.8499755859375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
