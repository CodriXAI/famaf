      "isDeleted": false,
      "boundElements": [],
      "updated": 1771119762978,
      "link": null,
      "locked": false,
      "text": "En términos de sumatorias esto se puede resumir como la suma desde 1 hasta n porq está en términos \nde Bv que dentro tiene una suma desde 1 hasta m porque está en términos de Bw:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En términos de sumatorias esto se puede resumir como la suma desde 1 hasta n porq está en términos \nde Bv que dentro tiene una suma desde 1 hasta m porque está en términos de Bw:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
