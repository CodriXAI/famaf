      "isDeleted": false,
      "boundElements": [],
      "updated": 1776551713415,
      "link": null,
      "locked": false,
      "text": "1 => 2 : A invertible => det(A) != 0",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 => 2 : A invertible => det(A) != 0",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mz5mL_7IEBytW-W1yzh2U",
      "type": "rectangle",
      "x": 9210.680439102254,
      "y": 11217.184846889555,
      "width": 648.5714285714294,
      "height": 84.28571428571377,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
