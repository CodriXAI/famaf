      "versionNonce": 1845984745,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772674177110,
      "link": null,
      "locked": false,
      "text": "Bu∩w : {v1, ... , vk} => dim(Bu∩w) = k ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bu∩w : {v1, ... , vk} => dim(Bu∩w) = k ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cs5izCJnCfn5ThSfWn0fj",
      "type": "text",
      "x": 129.75321345737848,
      "y": 11573.27160040658,
      "width": 1331.300048828125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "9GP-kpsjcEnjK0WBDBrEi",
      "index": "bHb",
      "roundness": null,
      "seed": 435703017,
      "version": 568,
      "versionNonce": 34724041,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772674177110,
      "link": null,
      "locked": false,
      "text": "Dicha intersección está contenida tanto en U como en W, por ende Bu∩w se\npuede extender a las bases Bu de U y Bw de W de forma tal que:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dicha intersección está contenida tanto en U como en W, por ende Bu∩w se\npuede extender a las bases Bu de U y Bw de W de forma tal que:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nhlVgq7ORNwvF8X5RxO0S",
      "type": "text",
      "x": 134.1138890874936,
      "y": 11685.751759136743,
      "width": 796.7666625976562,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
