    {
      "id": "7JLcbS5kHf_dNywsULQjD",
      "type": "text",
      "x": 7580.507151454563,
      "y": 5414.916851670623,
      "width": 1186.1500244140625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "wtoYBggReLR8qiHndCB0t",
      "index": "bF9",
      "roundness": null,
      "seed": 869401140,
      "version": 364,
      "versionNonce": 1574092340,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1771119746851,
      "link": null,
      "locked": false,
      "text": "T(vj) = a1jw1 + ... + amjwm, con a1j, ... , amj escalares con j = 1, ... ,n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T(vj) = a1jw1 + ... + amjwm, con a1j, ... , amj escalares con j = 1, ... ,n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RLEMLWFYaNQurxjFkMnET",
      "type": "text",
      "x": 7361.358321585701,
      "y": 5547.702565956334,
      "width": 134.48333740234375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "wtoYBggReLR8qiHndCB0t",
      "index": "bFA",
      "roundness": null,
      "seed": 222951052,
      "version": 217,
      "versionNonce": 744910604,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1771119746851,
      "link": null,
      "locked": false,
      "text": "Partimo",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Partimo",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jYWBSUccDQ8Zeibfp4BHW",
      "type": "text",
      "x": 7034.501178728558,
      "y": 5169.750185003953,
      "width": 1034.4166259765625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "wtoYBggReLR8qiHndCB0t",
      "index": "bFB",
      "roundness": null,
      "seed": 1733178932,
      "version": 388,
      "versionNonce": 72625972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771119762978,
      "link": null,
      "locked": false,
      "text": "Partiendo de esta definición tenemos el siguiente Teorema:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Partiendo de esta definición tenemos el siguiente Teorema:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2Vq17SfyqLIGL2Ten_5fE",
      "type": "text",
      "x": 7035.600020804452,
      "y": 5242.702565956335,
      "width": 845.9500122070312,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "wtoYBggReLR8qiHndCB0t",
      "index": "bFC",
      "roundness": null,
      "seed": 98557964,
      "version": 698,
      "versionNonce": 502278324,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771119762978,
      "link": null,
      "locked": false,
      "text": "Sea V,W Espacios Vectoriales de dimensión finita\nBv = {v1, ... , vn} una base de V\nBw = {w1, ... , wm} una base de W\nT : V -> W una transformación lineal.\n\nSea v ∈ V un vector\n\nEntonces tenemos que:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea V,W Espacios Vectoriales de dimensión finita\nBv = {v1, ... , vn} una base de V\nBw = {w1, ... , wm} una base de W\nT : V -> W una transformación lineal.\n\nSea v ∈ V un vector\n\nEntonces tenemos que:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XtKG263vUYSo9AW_mj9m_",
      "type": "text",
      "x": 7380.4869052213035,
      "y": 5641.809708813476,
      "width": 551.7999877929688,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "wtoYBggReLR8qiHndCB0t",
      "index": "bFD",
      "roundness": null,
      "seed": 19786508,
      "version": 152,
      "versionNonce": 1691415092,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771119762978,
      "link": null,
      "locked": false,
      "text": "[T(v)]Bw = [T]Bv,Bw * [v] Bv",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[T(v)]Bw = [T]Bv,Bw * [v] Bv",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZU1IhrOi2wePc3vY78fuk",
