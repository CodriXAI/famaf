      "versionNonce": 1523673559,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781747794138,
      "link": null,
      "locked": false,
      "text": "Por la Hipótesis inductiva,\nlos wi != 0, por ende <wi,wi> es NO NULO, \nlo que valida el denominador",
      "fontSize": 35.54631011178329,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por la Hipótesis inductiva,\nlos wi != 0, por ende <wi,wi> es NO NULO, \nlo que valida el denominador",
      "autoResize": true,
      "lineHeight": 1.25
    },
