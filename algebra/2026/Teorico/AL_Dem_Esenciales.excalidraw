    {
      "id": "oAtGTz2bfr_adp-5EfogO",
      "type": "text",
      "x": 9221.197101699916,
      "y": 12102.768180222887,
      "width": 1261.25,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "NXkdyAx3ZVT6ub2Sn7UrI",
      "index": "bJz",
      "roundness": null,
      "seed": 2142278315,
      "version": 932,
      "versionNonce": 1853415787,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776551713415,
      "link": null,
      "locked": false,
      "text": "Si el det(A) != 0, entonces el rango de la matriz es máximo, es decir n\n\nComo no existen filas nulas, y son L.I, entonces la única solución posible\nes la trivial, por lo tanto:\n\nAx = 0 con x = 0",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si el det(A) != 0, entonces el rango de la matriz es máximo, es decir n\n\nComo no existen filas nulas, y son L.I, entonces la única solución posible\nes la trivial, por lo tanto:\n\nAx = 0 con x = 0",
      "autoResize": true,
      "lineHeight": 1.25
    },
