    {
      "id": "V9rf18I5a8Dfy8VxW9qrA",
      "type": "text",
      "x": 7070.694869478849,
      "y": 6729.684265073786,
      "width": 2028.0333251953125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
