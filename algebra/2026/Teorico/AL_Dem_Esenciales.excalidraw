    },
    {
      "id": "rb9v9CUDsUbwQgVfUflBk",
      "type": "text",
      "x": 1004.3182643393848,
      "y": 11691.343028978008,
      "width": 443.70001220703125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
