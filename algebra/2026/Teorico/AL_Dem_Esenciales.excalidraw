    {
      "id": "YZgXG8eTSmbdejU_7ovUY",
      "type": "text",
      "x": 9213.44046946751,
      "y": 12532.004340658366,
      "width": 1448.3333740234375,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
