      "type": "text",
      "x": -604.3783744505947,
      "y": 531.9608396463121,
      "width": 1222.6666259765625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
