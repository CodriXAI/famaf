    {
      "id": "N0NKvTBWJlK0YQdIwxMgC",
      "type": "text",
      "x": -166.68033126226146,
      "y": 7827.391419751169,
      "width": 1442.36669921875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "DUIMQwd3pnhItW7qu6-Wb",
      "index": "bDF",
      "roundness": null,
      "seed": 475204623,
      "version": 411,
      "versionNonce": 264946977,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770241237148,
      "link": null,
      "locked": false,
      "text": "=> ai * vi está en Nu(T) para i = k+1, ... , n, pero Nu(T) = span {v1, ... , vk}\nY Bv = {v1, ... , vk, vk+1, ... vn} es L.I, entonces la UNICA forma de que una\ncombinación lineal entre vk+1, ... , vn esté en el Núcleo de T es NECESARIAMENTE\nque:\n        ak+1 = ... = an = 0 ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "=> ai * vi está en Nu(T) para i = k+1, ... , n, pero Nu(T) = span {v1, ... , vk}\nY Bv = {v1, ... , vk, vk+1, ... vn} es L.I, entonces la UNICA forma de que una\ncombinación lineal entre vk+1, ... , vn esté en el Núcleo de T es NECESARIAMENTE\nque:\n        ak+1 = ... = an = 0 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
