      "versionNonce": 2115610505,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772674237297,
      "link": null,
      "locked": false,
      "text": "Bw : {v1, ... , vk, w1, ... , wm} => dim(Bu) = k+m ",
