      "index": "bAd",
      "roundness": null,
      "seed": 2120362304,
      "version": 372,
      "versionNonce": 242936385,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1769627932204,
      "link": null,
      "locked": false,
      "text": "Un Grafo se dice K-Coloreable si tiene un coloreo\npropio con K colores y decimos que si | S | = k,\nentonces el Coloreo tiene k colores, generalmente\ndados por  S = {0, 1, ..., k-1 }",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un Grafo se dice K-Coloreable si tiene un coloreo propio con K colores y decimos que si | S | = k, entonces el Coloreo tiene k colores, generalmente dados por  S = {0, 1, ..., k-1 }",
      "autoResize": false,
      "lineHeight": 1.25
    },
