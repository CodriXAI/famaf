    {
      "id": "mRx4tbUj0eZPurNT74UuS",
      "type": "text",
      "x": 114.60397862509899,
      "y": 11118.450171835148,
      "width": 1301.316650390625,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
