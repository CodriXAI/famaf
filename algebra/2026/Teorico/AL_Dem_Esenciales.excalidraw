      "isDeleted": false,
      "boundElements": [],
      "updated": 1772674243244,
      "link": null,
      "locked": false,
      "text": "(Podrían NO tener misma \ncant de elementos)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(Podrían NO tener misma \ncant de elementos)",
