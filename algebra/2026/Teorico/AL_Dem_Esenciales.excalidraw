      "versionNonce": 1329886217,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772674234260,
      "link": null,
      "locked": false,
      "text": "Bu : {v1, ... , vk, u1, ... , un} => dim(Bu) = k+n ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bu : {v1, ... , vk, u1, ... , un} => dim(Bu) = k+n ",
