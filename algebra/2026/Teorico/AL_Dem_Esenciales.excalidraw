      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "9GP-kpsjcEnjK0WBDBrEi",
      "index": "bJE",
      "roundness": null,
      "seed": 1106513129,
      "version": 229,
      "versionNonce": 1973150023,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772674177110,
      "link": null,
      "locked": false,
      "text": "dim(U + W) = dim U + dim W - dim(U ∩ W) ",
