    {
      "id": "gVfE_UexPIV5oVmBV-rN0",
      "type": "text",
      "x": 3345.6500851568944,
      "y": 5602.155371809466,
      "width": 657.0833129882812,
      "height": 90,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
