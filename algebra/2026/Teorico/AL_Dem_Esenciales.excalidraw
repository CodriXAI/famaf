      "updated": 1772674172091,
      "link": null,
      "locked": false,
      "text": "El Teorema nos dice: Sea V un K-Espacio Vectorial de dimensión finita y sea\nT : V -> V un Operador Lineal, entonces:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
