      "isDeleted": false,
      "boundElements": [],
      "updated": 1781747794138,
      "link": null,
      "locked": false,
      "text": "Definiremos el primer vector como: v1 = w1\nAl ser un solo vector, el conjunto {w1} es ortogonal de forma trivial\ny es fácil ver que: gen{v1} = gen{w1}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Definiremos el primer vector como: v1 = w1\nAl ser un solo vector, el conjunto {w1} es ortogonal de forma trivial\ny es fácil ver que: gen{v1} = gen{w1}",
      "autoResize": true,
      "lineHeight": 1.25
    },
