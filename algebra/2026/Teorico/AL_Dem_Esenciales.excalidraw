    {
      "id": "ppcxiky1afuTHGwGfYbP8",
      "type": "text",
      "x": 3078.6645660863824,
      "y": 10181.780084984784,
      "width": 1624.88330078125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "dkwFnbGhjt6D0QZiUKEzZ",
      "index": "bJO",
      "roundness": null,
      "seed": 1569589372,
      "version": 272,
      "versionNonce": 1301265456,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776536976631,
      "link": null,
      "locked": false,
      "text": "Sea V un espacio vectorial. Si V está generado por un conjunto de r elementos {v1​,v2​,…,vr​} , \nentonces cualquier conjunto linealmente independiente {w1​,w2​,…,ws​} en V tiene como máximo \nr elementos (es decir, s≤r).",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea V un espacio vectorial. Si V está generado por un conjunto de r elementos {v1​,v2​,…,vr​} , \nentonces cualquier conjunto linealmente independiente {w1​,w2​,…,ws​} en V tiene como máximo \nr elementos (es decir, s≤r).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BNC3mg5CDohX7DvYAc0yP",
