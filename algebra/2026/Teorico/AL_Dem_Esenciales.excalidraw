      "updated": 1769627932204,
      "link": null,
      "locked": false,
      "text": "Como influye esta herramienta en la prueba del mínimo:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
