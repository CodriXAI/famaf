      "versionNonce": 152181131,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776551713415,
      "link": null,
      "locked": false,
      "text": "Al igual que el ejercicio anterior, dividiremos la demostración en diferentes puentes:\nEn este caso \"4 puentes\":\n\n1 => 2 | 2 => 3 | 3 => 4 | 4 => 1",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Al igual que el ejercicio anterior, dividiremos la demostración en diferentes puentes:\nEn este caso \"4 puentes\":\n\n1 => 2 | 2 => 3 | 3 => 4 | 4 => 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "k3bp-L5aI5prgbkXeCEIv",
      "type": "text",
      "x": 9226.39472481654,
      "y": 11236.113418318126,
      "width": 611.8666381835938,
