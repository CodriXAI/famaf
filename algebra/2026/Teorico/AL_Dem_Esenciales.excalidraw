      "boundElements": [],
      "updated": 1781747794140,
      "link": null,
      "locked": false,
      "text": "Sea A = gen{v1, ... , vk} ^ B = gen{w1, ... , wk}, para probar la\nigualdad, haremos doble inclusión, es decir:\n\nA incluido en B ^ B incluido en A => A = B",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea A = gen{v1, ... , vk} ^ B = gen{w1, ... , wk}, para probar la\nigualdad, haremos doble inclusión, es decir:\n\nA incluido en B ^ B incluido en A => A = B",
      "autoResize": true,
      "lineHeight": 1.25
    },
