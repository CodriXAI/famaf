    {
      "id": "t8-wckMTHDzt5CFyS_KE2",
      "type": "text",
      "x": -1033.3279517421274,
      "y": 3832.179706638093,
      "width": 1166.13330078125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "DUIMQwd3pnhItW7qu6-Wb",
      "index": "bBv",
      "roundness": null,
      "seed": 1776683969,
      "version": 263,
      "versionNonce": 878511508,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770850653935,
      "link": null,
      "locked": false,
      "text": "Sea T : V → W una transformación lineal, con V de dimensión finita.\nEntonces:\n    \n                dim(V) = dim(kerT) + dim(ImT)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea T : V → W una transformación lineal, con V de dimensión finita.\nEntonces:\n    \n                dim(V) = dim(kerT) + dim(ImT)",
      "autoResize": true,
      "lineHeight": 1.25
    },
