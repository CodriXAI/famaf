    {
      "id": "LZDa0lFTpRMSFs14GLprf",
      "type": "text",
      "x": 7050.129762364165,
      "y": 5958.107327861095,
      "width": 613.9833374023438,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "wtoYBggReLR8qiHndCB0t",
      "index": "bFG",
      "roundness": null,
      "seed": 1138136244,
      "version": 82,
      "versionNonce": 2010942388,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1771119762978,
      "link": null,
      "locked": false,
      "text": "Si aplicamos T a v, y por linealidad:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si aplicamos T a v, y por linealidad:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9z2ZO6kOtREnzBTKjQGb8",
      "type": "text",
      "x": 7444.804770502185,
      "y": 6040.27399452776,
      "width": 940.9166870117188,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "wtoYBggReLR8qiHndCB0t",
      "index": "bFH",
      "roundness": null,
      "seed": 838358964,
      "version": 434,
      "versionNonce": 691598644,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771119762978,
      "link": null,
      "locked": false,
      "text": "T(v) = λ1T(v1) + ... + λnT(vn) con λ1, ... , λn escalares",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T(v) = λ1T(v1) + ... + λnT(vn) con λ1, ... , λn escalares",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ay2Cp17HRiwzgwdHeBDfP",
      "type": "text",
      "x": 7054.804760329659,
      "y": 6120.607327861095,
      "width": 1786.050048828125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "wtoYBggReLR8qiHndCB0t",
      "index": "bFI",
      "roundness": null,
      "seed": 1299097868,
      "version": 246,
      "versionNonce": 374091444,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771119762978,
      "link": null,
      "locked": false,
      "text": "Por la definición del T(vj) se pueden escribir cada imágen del vector de la base Bv en términos de Bw:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por la definición del T(vj) se pueden escribir cada imágen del vector de la base Bv en términos de Bw:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BzIAQP-ojrlga9JviGC-u",
      "type": "text",
      "x": 7218.338085524973,
      "y": 6226.940661194428,
      "width": 1526.5833740234375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "wtoYBggReLR8qiHndCB0t",
      "index": "bFJ",
      "roundness": null,
      "seed": 576694580,
      "version": 527,
      "versionNonce": 1069299764,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771119762978,
      "link": null,
      "locked": false,
      "text": "T(v) = λ1(a11 w1 + ... + am1 wm) + ... + λn(a1n w1 + ... + amn wm) con λ1, ... , λn escalares",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T(v) = λ1(a11 w1 + ... + am1 wm) + ... + λn(a1n w1 + ... + amn wm) con λ1, ... , λn escalares",
      "autoResize": true,
      "lineHeight": 1.25
    },
