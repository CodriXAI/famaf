      "index": "bF6",
      "roundness": null,
      "seed": 465297076,
      "version": 368,
      "versionNonce": 341247412,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1771119762978,
      "link": null,
      "locked": false,
      "text": "v = λ1v1 + ... + λnvn con λ1, ... , λn escalares",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "v = λ1v1 + ... + λnvn con λ1, ... , λn escalares",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QKxJuCSdUGnpjFqmaW_HT",
      "type": "text",
      "x": 7398.048797776179,
      "y": 5284.91685167062,
      "width": 1746.0833740234375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
