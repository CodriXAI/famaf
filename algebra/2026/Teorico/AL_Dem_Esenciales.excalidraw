      "updated": 1772674177110,
      "link": null,
      "locked": false,
      "text": "Sabemos que U∩W es un subespacio, por lo tanto tiene una base tq ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sabemos que U∩W es un subespacio, por lo tanto tiene una base tq ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BhRfruWcP8fHZn7nicDS-",
      "type": "text",
      "x": 129.43731195843242,
      "y": 11507.835092470074,
      "width": 671.9166870117188,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
