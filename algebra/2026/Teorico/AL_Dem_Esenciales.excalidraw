    {
      "id": "JBmDkB6VGxINo4aAz3JD_",
      "type": "text",
      "x": 9222.619396407461,
      "y": 12866.203153912567,
      "width": 1559.316650390625,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
