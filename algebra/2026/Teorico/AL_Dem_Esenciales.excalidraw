    {
      "id": "PtVNF4WQC_no2HTfbGoWj",
      "type": "text",
      "x": -1054.3783744505947,
      "y": 421.96083964631214,
      "width": 1222.6666259765625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
