    {
      "id": "OxfyFKNPfH9enx8kgDlaW",
      "type": "text",
      "x": 588.5250216627694,
      "y": -508.36927185892046,
      "width": 628.012841118707,
      "height": 1076.6666666666667,
      "angle": 0,
      "strokeColor": "#1e1e1e",
