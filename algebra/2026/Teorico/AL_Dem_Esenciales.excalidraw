      "isDeleted": false,
      "boundElements": [],
      "updated": 1781747794138,
      "link": null,
      "locked": false,
      "text": "Queremos dar un vector wk tal que:\n* Sea ortogonal a los w1, ... , wk-1\n* Preserve el subespacio generado\nProponemos la definición del wk como:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Queremos dar un vector wk tal que:\n* Sea ortogonal a los w1, ... , wk-1\n* Preserve el subespacio generado\nProponemos la definición del wk como:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zUnAWOpHMeV_K4xfAdU3E",
      "type": "text",
      "x": 9763.119411783095,
      "y": 16105.323642777848,
      "width": 723.6666870117188,
      "height": 133.29866291918734,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "QAvbdlvkwvtBD9SQQAf7f",
      "index": "bNFK",
      "roundness": null,
      "seed": 1774884345,
