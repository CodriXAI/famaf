      "boundElements": [],
      "updated": 1779415570925,
      "link": null,
      "locked": false,
      "text": "\"Una Función que define un producto interno se puede\ninterpretar como un producto matricial\", es decir:\n\nSean V K-Espacio Vectorial\ny Φ : V x V -> R una función que define un producto interno en V\n\nSea v en V, w en V vectores, y A la matriz de coeficientes \nasociada a Φ, entonces Φ se puede escribir como:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Una Función que define un producto interno se puede\ninterpretar como un producto matricial\", es decir:\n\nSean V K-Espacio Vectorial\ny Φ : V x V -> R una función que define un producto interno en V\n\nSea v en V, w en V vectores, y A la matriz de coeficientes \nasociada a Φ, entonces Φ se puede escribir como:",
      "autoResize": true,
      "lineHeight": 1.25
    },
