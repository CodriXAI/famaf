      "boundElements": [],
      "updated": 1773004338086,
      "link": null,
      "locked": false,
      "text": "Una base es un conjunto maximal\nLINEALMENTE INDEPENDIENTE.\nSi agregaramos más elementos del\nnúcleo para extender la base.\nContradictoriamente se vuelve un \nconjunto L.D, por ende absurdo.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Una base es un conjunto maximal\nLINEALMENTE INDEPENDIENTE.\nSi agregaramos más elementos del\nnúcleo para extender la base.\nContradictoriamente se vuelve un \nconjunto L.D, por ende absurdo.",
      "autoResize": true,
      "lineHeight": 1.25
    },
