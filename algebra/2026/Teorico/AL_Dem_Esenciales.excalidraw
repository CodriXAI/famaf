      "roundness": null,
      "seed": 382260085,
      "version": 152,
      "versionNonce": 491802997,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779415570925,
      "link": null,
      "locked": false,
      "text": "Hacer pasos algebraicos para llegar de un método a otro en productos\ninternos es equivalente, y demuestra que hay una relación",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hacer pasos algebraicos para llegar de un método a otro en productos\ninternos es equivalente, y demuestra que hay una relación",
      "autoResize": true,
      "lineHeight": 1.25
    },
