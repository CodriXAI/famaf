      "index": "bKI9",
      "roundness": null,
      "seed": 707508027,
      "version": 236,
      "versionNonce": 80800251,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779417000026,
      "link": null,
      "locked": false,
      "text": "Es trivial pues tendríamos únicamente:\na1v1 = 0, luego como v1 es autovector entonces v1 != 0\n=> ai = 0 => v1 es L.I",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Es trivial pues tendríamos únicamente:\na1v1 = 0, luego como v1 es autovector entonces v1 != 0\n=> ai = 0 => v1 es L.I",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Gs0n2WnnJbxPGVMh16QQs",
      "type": "text",
      "x": 4749.628545459534,
      "y": 13593.773138024382,
      "width": 1165.5833740234375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "EIGQLbb9j0jCLZzlTFB8-",
      "index": "bKIA",
      "roundness": null,
      "seed": 1903169563,
      "version": 89,
      "versionNonce": 414708379,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779417000026,
      "link": null,
      "locked": false,
      "text": "Y la prueba se realiza por inducción, donde en el Caso Inductivo se\nutilizará un artificio para 'hacer desaparecer' vk+1 y usar la H.I",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Y la prueba se realiza por inducción, donde en el Caso Inductivo se\nutilizará un artificio para 'hacer desaparecer' vk+1 y usar la H.I",
      "autoResize": true,
      "lineHeight": 1.25
    },
