      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(La base de la intersección aparece 2 veces, lo que da lugar a dependencias\nlineales en esta base candidata de U + W)",
      "autoResize": true,
      "lineHeight": 1.25
    },
