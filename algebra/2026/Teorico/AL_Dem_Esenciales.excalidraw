      "index": "bF5",
      "roundness": null,
      "seed": 2030150068,
      "version": 348,
      "versionNonce": 1301457972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771119762977,
      "link": null,
      "locked": false,
      "text": "Sea v ∈ V un vector, como pertenece a V podemos escribirlo en términos de la base Bv tq: ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea v ∈ V un vector, como pertenece a V podemos escribirlo en términos de la base Bv tq: ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JCHnqzxPzw1_AgfzIvEuV",
      "type": "text",
      "x": 7440.332143316544,
      "y": 5885.583518337289,
      "width": 757.316650390625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
