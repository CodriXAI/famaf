      "updated": 1772674177110,
      "link": null,
      "locked": false,
      "text": "Sea V un K-Espacio Vectorial y Sean U,W ⊆ V subespacios de dimensión \nfinita. Entonces:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea V un K-Espacio Vectorial y Sean U,W ⊆ V subespacios de dimensión \nfinita. Entonces:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "98_VCogqH30U3Eh914AD6",
      "type": "text",
      "x": 348.6674706885914,
      "y": 10160.81128294626,
      "width": 729.933349609375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "9GP-kpsjcEnjK0WBDBrEi",
      "index": "bHG",
      "roundness": null,
      "seed": 1338925065,
      "version": 212,
      "versionNonce": 120280551,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772674177110,
      "link": null,
      "locked": false,
      "text": "dim(U + W) = dim U + dim W - dim(U ∩ W) ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "dim(U + W) = dim U + dim W - dim(U ∩ W) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-nT9Gc2ry4usbrW3Dk4x3",
      "type": "rectangle",
