    {
      "id": "N0NKvTBWJlK0YQdIwxMgC",
      "type": "text",
      "x": -1206.6803312622615,
      "y": 7737.391419751169,
      "width": 1442.36669921875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
