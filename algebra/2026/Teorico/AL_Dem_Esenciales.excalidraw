      "boundElements": [],
      "updated": 1769992554632,
      "link": null,
      "locked": false,
      "text": "Sea el Espacio Vectorial V = R³ y W= { (x,y,z) ∈ R³ : x − 2y + z = 0 }\nProbar que W es subespacio",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea el Espacio Vectorial V = R³ y W= { (x,y,z) ∈ R³ : x − 2y + z = 0 }\nProbar que W es subespacio",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "949IM_BeJw6yqHsa0buIA",
