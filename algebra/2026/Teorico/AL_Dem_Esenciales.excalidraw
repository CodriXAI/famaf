    {
      "id": "0jfIN_tvKE-urKh1XqGLm",
      "type": "text",
      "x": -603.6969991447659,
      "y": 819.2853467022039,
      "width": 417.20001220703125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
