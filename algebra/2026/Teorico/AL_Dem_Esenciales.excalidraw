      "seed": 14883136,
      "version": 343,
      "versionNonce": 1814180975,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1769630924148,
      "link": null,
      "locked": false,
      "text": "Sea G un grafo G = (V,E), Un coloreo es propio si \n\nxy ∈ E(G) ⇒ c(x) ≠ c(y ) \n\n(extremos con distinto color)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea G un grafo G = (V,E), Un coloreo es propio si \n\nxy ∈ E(G) ⇒ c(x) ≠ c(y ) \n\n(extremos con distinto color)",
      "autoResize": true,
      "lineHeight": 1.25
    },
