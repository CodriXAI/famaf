      "type": "text",
      "x": 2297.635480893153,
      "y": -115.07152758784378,
      "width": 602.8499755859375,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
