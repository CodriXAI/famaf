    {
      "id": "moiUqSAe4EqVkVqzY_qs5",
      "type": "text",
      "x": 69.05551867986827,
      "y": 2934.4670855377867,
      "width": 353.29998779296875,
      "height": 201.00000000000006,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF8",
      "roundness": null,
      "seed": 1947889525,
      "version": 544,
      "versionNonce": 956881761,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777673895966,
      "link": null,
      "locked": false,
      "text": "Acordarse que\ni/1+i es 1+i/2, pues:\n\n i * (1-i) =   i-i²   = i+1 = 1+i\n\n1+i  (1-i)   1-i+i-i² = 1+1 =  2",
      "fontSize": 26.800000000000004,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Acordarse que\ni/1+i es 1+i/2, pues:\n\n i * (1-i) =   i-i²   = i+1 = 1+i\n\n1+i  (1-i)   1-i+i-i² = 1+1 =  2",
      "autoResize": true,
      "lineHeight": 1.25
    },
