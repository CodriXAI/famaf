      "seed": 735757812,
      "version": 278,
      "versionNonce": 595873025,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777672941172,
      "link": null,
      "locked": false,
      "text": "Para ello (1,1,1,1) debe cumplir que: \n3(1) - 5(1) - 2(1) + 1 = 0\nLuego:\n3 - 5 - 2 + 1 = 0\n-2 - 2 + 1 = 0\n-4 + 1 = 0\n-3 = 0\nABS\n\n(1,1,1,1) NO pertenece a G",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Para ello (1,1,1,1) debe cumplir que: \n3(1) - 5(1) - 2(1) + 1 = 0\nLuego:\n3 - 5 - 2 + 1 = 0\n-2 - 2 + 1 = 0\n-4 + 1 = 0\n-3 = 0\nABS\n\n(1,1,1,1) NO pertenece a G",
      "autoResize": true,
      "lineHeight": 1.25
    },
