      "isDeleted": false,
      "boundElements": [],
      "updated": 1777674151373,
      "link": null,
      "locked": false,
      "text": "E1): A la fila i, sumarle el múltiplo de la fila j => fi + a * fj\n\nE2): A la fila i, la multiplico por el escalar \"a\" => a * fi\n\nE3): Permutar la fila i con la fila j => fi <-> fj",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "E1): A la fila i, sumarle el múltiplo de la fila j => fi + a * fj\n\nE2): A la fila i, la multiplico por el escalar \"a\" => a * fi\n\nE3): Permutar la fila i con la fila j => fi <-> fj",
      "autoResize": true,
      "lineHeight": 1.25
    },
