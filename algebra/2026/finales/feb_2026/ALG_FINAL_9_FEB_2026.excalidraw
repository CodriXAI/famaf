      "versionNonce": 1442688273,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778772862762,
      "link": null,
      "locked": false,
      "text": "Φ((x1,y1,z1), (x1,y1,z1)) = x1² - 2x1y1 - 2x1y1 + 5y1² + z1² >= 0\n\nx1² - 2x1y1 - 2x1y1 + 5y1² + z1² >= 0\nx1² - 4x1y1 + 5y1² + z1² >= 0 ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Φ((x1,y1,z1), (x1,y1,z1)) = x1² - 2x1y1 - 2x1y1 + 5y1² + z1² >= 0\n\nx1² - 2x1y1 - 2x1y1 + 5y1² + z1² >= 0\nx1² - 4x1y1 + 5y1² + z1² >= 0 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
