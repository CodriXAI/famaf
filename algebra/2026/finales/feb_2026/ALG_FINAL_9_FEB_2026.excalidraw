    {
      "id": "-4wmCr61O0opSmXOIeAVE",
      "type": "text",
      "x": 2817.9546272766947,
      "y": 119.4408493154146,
      "width": 1253.800048828125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
