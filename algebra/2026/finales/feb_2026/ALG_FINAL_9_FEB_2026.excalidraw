      "updated": 1777752558832,
      "link": null,
      "locked": false,
      "text": "T : R^n -> R^n transformación lineal (en particular un operador lineal)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T : R^n -> R^n transformación lineal (en particular un operador lineal)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ceXmztiOX1CstuqaQfAlm",
      "type": "text",
      "x": 47.63579347132605,
      "y": 4643.782143990674,
      "width": 881.183349609375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHz",
      "roundness": null,
      "seed": 86245512,
      "version": 62,
      "versionNonce": 1427498744,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1777752558832,
      "link": null,
      "locked": false,
      "text": "Donde <T(v), T(w)> = <v,w> para todo v,w en R^n",
