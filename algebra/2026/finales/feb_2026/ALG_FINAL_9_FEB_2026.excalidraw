    {
      "id": "85Cq0kH-I4BvhLVTt-Y_T",
      "type": "text",
      "x": 2839.6638669382933,
      "y": 3807.051681512248,
      "width": 1917.8499755859375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bL1",
      "roundness": null,
      "seed": 1162734216,
      "version": 268,
      "versionNonce": 68569480,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777758304118,
      "link": null,
      "locked": false,
      "text": "NO tenemos más autovalores distintos, por ende no hay mas autoespacios.\n\nLuego por el teorema de diagonalización: T es diagonalizable si dim(V) = suma de dimensiones de autoespacios\n\nLuego dim(R⁴) = dim(Eλ1) + dim(Eλ2)\n        4 = 1 + 1\n        4 = 2",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NO tenemos más autovalores distintos, por ende no hay mas autoespacios.\n\nLuego por el teorema de diagonalización: T es diagonalizable si dim(V) = suma de dimensiones de autoespacios\n\nLuego dim(R⁴) = dim(Eλ1) + dim(Eλ2)\n        4 = 1 + 1\n        4 = 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
