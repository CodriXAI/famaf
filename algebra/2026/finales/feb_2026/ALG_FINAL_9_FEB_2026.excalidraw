    {
      "id": "bBMGbzEWtlwJkLaKkuXCY",
      "type": "text",
      "x": 2800.4342688149145,
      "y": 9826.369258934965,
      "width": 2207.9833984375,
      "height": 136,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bPh",
      "roundness": null,
      "seed": 2088895506,
      "version": 327,
      "versionNonce": 1006557951,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778788032389,
      "link": null,
      "locked": false,
      "text": "Por Teorema de la Dimensión, para que exista la transformación lineal condicionada \nen el ejercicio, debería ocurrir que:",
      "fontSize": 54.4,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por Teorema de la Dimensión, para que exista la transformación lineal condicionada \nen el ejercicio, debería ocurrir que:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nJauMxc-kEyZeKHzJRhZQ",
      "type": "text",
      "x": 3329.4342688149145,
      "y": 10018.65497322068,
      "width": 922.2954963805116,
      "height": 69.28571428571374,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bPi",
      "roundness": null,
      "seed": 891839182,
      "version": 179,
      "versionNonce": 579412767,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778788032389,
      "link": null,
      "locked": false,
      "text": "dim(R⁵) = dim(Nu(T)) + dim(Im(T))",
      "fontSize": 55.42857142857101,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "dim(R⁵) = dim(Nu(T)) + dim(Im(T))",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PnSCcm2C1KARTTxW1D9-f",
      "type": "rectangle",
      "x": 3305.1485545292003,
      "y": 9994.01211607782,
      "width": 977.1428571428573,
      "height": 115.71428571428623,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bPj",
      "roundness": {
        "type": 3
      },
      "seed": 193478226,
      "version": 121,
      "versionNonce": 752183103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778788032389,
      "link": null,
      "locked": false
    },
    {
      "id": "zOJIksyvnoEXB3aYu4zrT",
      "type": "text",
      "x": 2809.4342688149145,
      "y": 10158.654973220679,
      "width": 2036.2166748046875,
      "height": 179.00000000000003,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bPk",
      "roundness": null,
      "seed": 424617678,
      "version": 397,
      "versionNonce": 155461471,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778788032389,
      "link": null,
      "locked": false,
      "text": "Sabemos que Nu(T) : span {(1,-1,1,-1,1), (1,2,3,4,5), (4,-1,6,1,8)}. Para evaluar dim(Nu(T)), \ndeberemos buscar una base, es decir, ver cuáles de los vectores generadores del Nu(T) \nson L.I, para ello armaremos la Matriz y evaluaremos mediante Gauss-Jordan:",
      "fontSize": 47.73333333333334,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sabemos que Nu(T) : span {(1,-1,1,-1,1), (1,2,3,4,5), (4,-1,6,1,8)}. Para evaluar dim(Nu(T)), \ndeberemos buscar una base, es decir, ver cuáles de los vectores generadores del Nu(T) \nson L.I, para ello armaremos la Matriz y evaluaremos mediante Gauss-Jordan:",
      "autoResize": true,
      "lineHeight": 1.25
    },
