    {
      "id": "-nHeOi8npUOLf0Y_Q15GU",
      "type": "text",
      "x": 142.75484109037313,
      "y": 6617.502382085911,
      "width": 171.36666870117188,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
