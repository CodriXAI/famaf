      "seed": 1194429432,
      "version": 243,
      "versionNonce": 318022792,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777756223188,
      "link": null,
      "locked": false,
      "text": "Con K = R (Los Reales)\nEncontramos la matriz A asociada a T obteniendo los vectores columna\naplicando T a la base canónica y armando A con los vectores columna",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Con K = R (Los Reales)\nEncontramos la matriz A asociada a T obteniendo los vectores columna\naplicando T a la base canónica y armando A con los vectores columna",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZIpA3Je54Ig7eCOEnGomX",
      "type": "text",
      "x": 2817.447763806122,
      "y": 273.87627595674525,
      "width": 389.3666687011719,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIM",
      "roundness": null,
      "seed": 1505640840,
      "version": 137,
      "versionNonce": 1188925688,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777756234181,
      "link": null,
      "locked": false,
      "text": "T((1,0,0,0)) = (0,0,0,1)\nT((0,1,0,0)) = (1,0,0,0)\nT((0,0,1,0)) = (0,1,0,0)\nT((0,0,0,1) = (0,0,1,0)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T((1,0,0,0)) = (0,0,0,1)\nT((0,1,0,0)) = (1,0,0,0)\nT((0,0,1,0)) = (0,1,0,0)\nT((0,0,0,1) = (0,0,1,0)",
      "autoResize": true,
      "lineHeight": 1.25
    },
