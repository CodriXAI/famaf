    {
      "id": "e_sTWMJvUfaVH5PItC8M_",
      "type": "text",
      "x": 4948.575356525334,
      "y": 3858.849708424456,
      "width": 1917.8499755859375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
