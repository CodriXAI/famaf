    {
      "id": "sYx5LKTwyD7WimnzaRJqo",
      "type": "text",
      "x": 91.45493749718162,
      "y": 1358.543986165104,
      "width": 1767.61669921875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHl",
      "roundness": null,
      "seed": 1165733071,
      "version": 709,
      "versionNonce": 781374456,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777749719563,
      "link": null,
      "locked": false,
      "text": "Sea B1 : {a1, ... , an} base de V y Sea B2 : {b1, ... , bm} otra base de V => dim(B1) = n ^ dim(B2) = m\npor la definición de dimensión anterior.\n\nProbaremos entonces que efectivamente se cumple que si B1, B2 son bases de V => n = m",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea B1 : {a1, ... , an} base de V y Sea B2 : {b1, ... , bm} otra base de V => dim(B1) = n ^ dim(B2) = m\npor la definición de dimensión anterior.\n\nProbaremos entonces que efectivamente se cumple que si B1, B2 son bases de V => n = m",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZzjRZE1SXM-N1ky1OVS_l",
      "type": "rectangle",
      "x": 1560.2278081442892,
      "y": 1490.0592104696238,
      "width": 105.11852734737136,
      "height": 52.14541120381409,
      "angle": 0,
      "strokeColor": "#1971c2",
