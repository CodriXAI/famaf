      "isDeleted": false,
      "boundElements": [],
      "updated": 1778772862762,
      "link": null,
      "locked": false,
      "text": "Φ((x1,y1,z1), (x2,y2,z2)) = x1x2 - 2x1y2 - 2x2y1 + 5y1y2 + z1z2 ",
