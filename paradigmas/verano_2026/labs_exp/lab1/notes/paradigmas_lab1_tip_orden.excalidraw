    {
      "id": "eFMKdtGTAXfuZW1sjMrib",
      "type": "text",
      "x": 6518.866714245635,
      "y": -1581.9511489480856,
      "width": 3537.5,
      "height": 974.9999999999998,
      "angle": 0,
