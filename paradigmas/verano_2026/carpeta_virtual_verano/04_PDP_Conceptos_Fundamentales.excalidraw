      "link": null,
      "locked": false,
      "text": "Turing-Completo:",
      "fontSize": 44.04705882352943,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Turing-Completo:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "obLoLWsS4OKU165QdoZiT",
      "type": "ellipse",
      "x": 109.60171900563773,
      "y": -978.7268068526441,
      "width": 412.50420168067257,
      "height": 148.57142857142867,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
