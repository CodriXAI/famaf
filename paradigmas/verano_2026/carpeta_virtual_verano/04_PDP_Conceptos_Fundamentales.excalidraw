    {
      "id": "0nwO16KBYuRF_MMEGApjC",
      "type": "text",
      "x": 3786.7769854479775,
      "y": 4691.364378317871,
      "width": 1120.316650390625,
      "height": 855,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "zZHEKrB1Qnsem36TIb1JN",
      "index": "b6M",
      "roundness": null,
      "seed": 164882503,
      "version": 106,
      "versionNonce": 851501369,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1769464937431,
      "link": null,
      "locked": false,
      "text": "Derivación de Ejemplo:\n\nif(a == b){\n    if(3 < 4){\n        a = x;\n    }\n}\n\n=> IF_STMT\n=> if ( COND ) { CUERPO }\n=> if ( VALOR OPERADOR VALOR ) { CUERPO }\n=> if (a == b) { CUERPO }\n=> if (a == b) { SENTENCIA CUERPO }\n=> if (a == b) { IF_STMT ϵ }\n=> if (a == b) { if ( COND ) { CUERPO } }\n=> if (a == b) { if ( VALOR OPERADOR VALOR ) { CUERPO } }\n=> if (a == b) { if (3 < 4) { SENTENCIA CUERPO } }\n=> if (a == b) { if (3 < 4) { id = VALOR ϵ } }\n=> if (a == b) { if (3 < 4) { a = x; } }",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Derivación de Ejemplo:\n\nif(a == b){\n    if(3 < 4){\n        a = x;\n    }\n}\n\n=> IF_STMT\n=> if ( COND ) { CUERPO }\n=> if ( VALOR OPERADOR VALOR ) { CUERPO }\n=> if (a == b) { CUERPO }\n=> if (a == b) { SENTENCIA CUERPO }\n=> if (a == b) { IF_STMT ϵ }\n=> if (a == b) { if ( COND ) { CUERPO } }\n=> if (a == b) { if ( VALOR OPERADOR VALOR ) { CUERPO } }\n=> if (a == b) { if (3 < 4) { SENTENCIA CUERPO } }\n=> if (a == b) { if (3 < 4) { id = VALOR ϵ } }\n=> if (a == b) { if (3 < 4) { a = x; } }",
      "autoResize": true,
      "lineHeight": 1.25
    },
