    {
      "id": "qllSCedPU5FgRs8rJQlIM",
      "type": "text",
      "x": 1804.3683494324996,
      "y": -1237.7409325392834,
      "width": 1169.050048828125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
