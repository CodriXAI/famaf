    {
      "id": "w9fZOTxVp8hzPnXr0Ts2N",
      "type": "text",
      "x": 1012.4577989548425,
      "y": 1031.7180472121634,
      "width": 1035.199951171875,
      "height": 1170,
      "angle": 0,
      "strokeColor": "#1e1e1e",
