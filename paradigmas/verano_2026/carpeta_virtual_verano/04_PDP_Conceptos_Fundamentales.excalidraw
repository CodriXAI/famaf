    {
      "id": "HsU2-jer16b5ctAeIB5Tc",
      "type": "text",
      "x": 1335.2104562851368,
      "y": 2137.8882725124354,
      "width": 731.183349609375,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
