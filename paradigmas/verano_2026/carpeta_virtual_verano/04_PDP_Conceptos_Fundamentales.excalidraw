    {
      "id": "eulfSNdb-8CysuEsYmnL-",
      "type": "text",
      "x": 1642.46033123922,
      "y": -1250.8392897567978,
      "width": 1460.3451974051338,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAS",
      "roundness": null,
      "seed": 932262039,
      "version": 663,
      "versionNonce": 1198866201,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769729909826,
      "link": null,
      "locked": false,
      "text": "En esta sección se busca nombrar y profundizar en las bases que\ntodo lenguaje de programación debe seguir como mínimo para poder\nconsiderarse como tal. Esto está referido principalmente al Paradigma Imperativo,\nsin embargo, se puede extender a diferentes Paradigmas, ya que parten\nde la misma base.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En esta sección se busca nombrar y profundizar en las bases que\ntodo lenguaje de programación debe seguir como mínimo para poder\nconsiderarse como tal. Esto está referido principalmente al Paradigma Imperativo,\nsin embargo, se puede extender a diferentes Paradigmas, ya que parten\nde la misma base.",
      "autoResize": false,
      "lineHeight": 1.25
    },
