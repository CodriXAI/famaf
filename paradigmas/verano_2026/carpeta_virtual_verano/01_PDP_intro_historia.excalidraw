    },
    {
      "id": "6jEWJwH1mrEp5DB-ODvbF",
      "type": "text",
      "x": 246.33612019320253,
      "y": 2358.6576557115827,
      "width": 389.29998779296875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3S",
      "roundness": null,
      "seed": 555895252,
      "version": 168,
      "versionNonce": 1452815340,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768173917333,
      "link": null,
      "locked": false,
      "text": "Diseñado en 1958-1960\nGran influencia en lenguajes modernos\nespecifican la sintaxis formalmente con BNF\nalcance léxico: begin … end or {…}\nprocedimientos modulares, recursivos, declaración \ndel tipo de las variables\n“Birth of computer science”  -- Dijkstra\n“A lenguaje so far ahead of its time that it was \nnot only an improvement on its predecessors, but \nalso on nearly all its successors”  -- Hoare ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Diseñado en 1958-1960\nGran influencia en lenguajes modernos\nespecifican la sintaxis formalmente con BNF\nalcance léxico: begin … end or {…}\nprocedimientos modulares, recursivos, declaración \ndel tipo de las variables\n“Birth of computer science”  -- Dijkstra\n“A lenguaje so far ahead of its time that it was \nnot only an improvement on its predecessors, but \nalso on nearly all its successors”  -- Hoare ",
      "autoResize": true,
      "lineHeight": 1.25
    },
