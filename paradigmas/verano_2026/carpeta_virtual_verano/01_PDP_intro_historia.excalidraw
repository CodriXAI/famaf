    {
      "id": "GrjkXCAFOq5dMFIHHUTeK",
      "type": "text",
      "x": 212.38343609162632,
      "y": 1864.132805472686,
      "width": 408.6333312988281,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
