      "type": "text",
      "x": 1683.954587027379,
      "y": 1680.4479032934166,
      "width": 438.23333740234375,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
