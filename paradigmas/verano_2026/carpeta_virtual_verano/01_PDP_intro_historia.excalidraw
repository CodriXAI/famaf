    {
      "id": "QZFS2V_XAvbgfqaAQG1FO",
      "type": "text",
      "x": 1714.3481273931234,
      "y": 2380.8529121687243,
      "width": 462.7833251953125,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3z",
      "roundness": null,
      "seed": 2027649772,
      "version": 249,
      "versionNonce": 1218034796,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768173917333,
      "link": null,
      "locked": false,
      "text": "Sun 1991-1995 (James Gosling) mezcla de C y Modula-3\n\nA diferencia de C++:\nNo usa templates (más adelante provee genéricos), \nno implementa herencia múltiple, no permite sobrecarga \nde operadores.\n\nComo Modula-3:\ninterfaces explícitas, herencia múltiple, manejo \nde excepciones, modelo de threading incorporado, \nreferencias y garbage collection automático (sin punteros!!)\n ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sun 1991-1995 (James Gosling) mezcla de C y Modula-3\n\nA diferencia de C++:\nNo usa templates (más adelante provee genéricos), \nno implementa herencia múltiple, no permite sobrecarga \nde operadores.\n\nComo Modula-3:\ninterfaces explícitas, herencia múltiple, manejo \nde excepciones, modelo de threading incorporado, \nreferencias y garbage collection automático (sin punteros!!)\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
