      "text": "Def: ¿Qué es un lenguaje de Programación?",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Def: ¿Qué es un lenguaje de Programación?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NRsQG2qQ2LrBh-BJflXTT",
      "type": "ellipse",
      "x": 1855.9975009781529,
      "y": -784.450516679862,
      "width": 821.048878212647,
      "height": 131.36782051402352,
      "angle": 0,
      "strokeColor": "#9c36b5",
