    },
    {
      "id": "bdYRkpGsZfjCB_dD5ATu-",
      "type": "text",
      "x": 1875.6180295633328,
      "y": -632.2257728384596,
      "width": 1005.8521875747141,
      "height": 394.8245987998041,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Q",
      "roundness": null,
      "seed": 76409887,
      "version": 525,
      "versionNonce": 1775427180,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768174106980,
      "link": null,
      "locked": false,
      "text": "Un lenguaje de programación es un sistema formal de \ninstrucciones, símbolos y reglas (sintaxis) que permite \na los humanos comunicarse con las computadoras, dándoles \nórdenes para realizar tareas específicas y crear programas, \naplicaciones y sistemas, actuando como un puente entre el \npensamiento humano y la ejecución de la máquina. \n\nEstos lenguajes definen algoritmos y procesos lógicos, y \nexisten diferentes tipos (alto nivel, bajo nivel) según su cercanía \nal hardware y su propósito.",
      "fontSize": 31.585967903984326,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un lenguaje de programación es un sistema formal de \ninstrucciones, símbolos y reglas (sintaxis) que permite \na los humanos comunicarse con las computadoras, dándoles \nórdenes para realizar tareas específicas y crear programas, \naplicaciones y sistemas, actuando como un puente entre el \npensamiento humano y la ejecución de la máquina. \n\nEstos lenguajes definen algoritmos y procesos lógicos, y \nexisten diferentes tipos (alto nivel, bajo nivel) según su cercanía \nal hardware y su propósito.",
      "autoResize": true,
      "lineHeight": 1.25
    },
