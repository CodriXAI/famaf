      "boundElements": [],
      "updated": 1768173917333,
      "link": null,
      "locked": false,
      "text": "Niklaus Wirth\nRevisa el sistema de tipos de Algol\nBuenos conceptos de estructuras de datos\nRecords, variantes, subrangos\nMás restrictivo que Algol 60/68\nLos parámetros de procedimiento no pueden \ntener parámetros de procedimiento\nLenguaje popular para enseñanza\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Niklaus Wirth\nRevisa el sistema de tipos de Algol\nBuenos conceptos de estructuras de datos\nRecords, variantes, subrangos\nMás restrictivo que Algol 60/68\nLos parámetros de procedimiento no pueden \ntener parámetros de procedimiento\nLenguaje popular para enseñanza\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
