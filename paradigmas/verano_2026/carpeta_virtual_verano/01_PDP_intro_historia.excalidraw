      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Def: ¿Qué es un Paradigma?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xgeMzinkeRg5wH3rp2O5v",
      "type": "ellipse",
      "x": 555.2158068016829,
