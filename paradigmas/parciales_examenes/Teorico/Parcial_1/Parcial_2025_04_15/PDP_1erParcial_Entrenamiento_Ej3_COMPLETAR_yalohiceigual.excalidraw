      "boundElements": [],
      "updated": 1776205235179,
      "link": null,
      "locked": false,
      "text": "$z = 14;\n$x = 3;\n$y = 10;\n\nsub foo {\n    ( $x , $y ) = @ ; # Parametros de foo\n    $x = $y+$z ;\n    $z = $x ;\n}\nsub baz {\n    ( $x , $y ) = @ ; # Parametros de baz\n    $y = $x++;\n    $z = 42;          # Variable local\n    foo( $x , $y ) ;\n    print ” $z \\n ” ;\n}\n\nbaz ( $x , $y ) ;\nprint ” $z \\n ”",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "$z = 14;\n$x = 3;\n$y = 10;\n\nsub foo {\n    ( $x , $y ) = @ ; # Parametros de foo\n    $x = $y+$z ;\n    $z = $x ;\n}\nsub baz {\n    ( $x , $y ) = @ ; # Parametros de baz\n    $y = $x++;\n    $z = 42;          # Variable local\n    foo( $x , $y ) ;\n    print ” $z \\n ” ;\n}\n\nbaz ( $x , $y ) ;\nprint ” $z \\n ”",
      "autoResize": true,
      "lineHeight": 1.25
    },
