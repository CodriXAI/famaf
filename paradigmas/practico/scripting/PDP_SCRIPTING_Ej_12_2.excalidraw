    {
      "id": "8FxhuxiXT_1IwENffqG7Y",
      "type": "text",
      "x": 2093.298866290147,
      "y": -277.84861624179644,
      "width": 1287,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c30F",
      "roundness": null,
      "seed": 1261055979,
      "version": 470,
      "versionNonce": 518007653,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780347551543,
      "link": null,
      "locked": false,
      "text": "Al no haber un main central que se encargue de la ejecución\ndel programa, se da a entender que las funciones se ejecutan\nde forma reactiva, como por ejemplo en:\ndemon1_run=[$run6, demon1_run1]\n\nSimilar al 'Lazy' de funcional, es una forma que tienen los\nscripts para poder conectar en este caso eventos como animaciones\nu otras funciones del motor del juego, con este script de modding",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Al no haber un main central que se encargue de la ejecución\ndel programa, se da a entender que las funciones se ejecutan\nde forma reactiva, como por ejemplo en:\ndemon1_run=[$run6, demon1_run1]\n\nSimilar al 'Lazy' de funcional, es una forma que tienen los\nscripts para poder conectar en este caso eventos como animaciones\nu otras funciones del motor del juego, con este script de modding",
      "autoResize": true,
      "lineHeight": 1.25
    }
