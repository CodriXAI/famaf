    {
      "id": "_rtBzSbLZLsay_0gLgLAa",
      "type": "text",
      "x": 1436.3226758139563,
      "y": -1041.7593305275104,
      "width": 1346.4000244140625,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
