      "text": "begin\n  integer n;\n  procedure p (k: integer);\n    begin\n      k := k+2;\n      print(n);\n      n := n + (2 * k);\n    end;\n  n := 4;\n  p(n);\n  print(n);\nend;",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "begin\n  integer n;\n  procedure p (k: integer);\n    begin\n      k := k+2;\n      print(n);\n      n := n + (2 * k);\n    end;\n  n := 4;\n  p(n);\n  print(n);\nend;",
      "autoResize": true,
      "lineHeight": 1.25
