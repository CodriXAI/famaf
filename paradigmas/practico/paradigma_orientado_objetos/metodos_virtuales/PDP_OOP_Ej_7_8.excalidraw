      "index": "bGI",
      "roundness": null,
      "seed": 1088614503,
      "version": 469,
      "versionNonce": 1121494567,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1777512031098,
      "link": null,
      "locked": false,
      "text": "Se crea una instancia de Human:\nHuman.new => \n    @@count = 1 (Being por \"super\")\n    creamos un ser (Being por \"super\")\n    creamos un humano (Por Human)\nSe crea una instancia de Dog y se almacena en d\nd = dog.new => \n    @@count = 2 (Being por \"super\" de Animal)\n    creamos un ser (Being por \"super\" de Animal)\n    creamos un animal (Animal por \"super\" de Dog)\n    creamos un perro (Por Dog)\n    d = dog.new",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se crea una instancia de Human:\nHuman.new => \n    @@count = 1 (Being por \"super\")\n    creamos un ser (Being por \"super\")\n    creamos un humano (Por Human)\nSe crea una instancia de Dog y se almacena en d\nd = dog.new => \n    @@count = 2 (Being por \"super\" de Animal)\n    creamos un ser (Being por \"super\" de Animal)\n    creamos un animal (Animal por \"super\" de Dog)\n    creamos un perro (Por Dog)\n    d = dog.new",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "o56ClqSoTvUZJtXFNZs2e",
