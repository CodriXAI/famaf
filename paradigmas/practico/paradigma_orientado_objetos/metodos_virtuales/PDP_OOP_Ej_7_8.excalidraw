    {
      "id": "ZWWywjLLQZcCaJwc-O65V",
      "type": "text",
      "x": 755.4828197756588,
      "y": 1582.5924596380992,
      "width": 855.6333618164062,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
