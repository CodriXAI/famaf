    {
      "id": "YUCzqXWyEGAqkcMTBUNc7",
      "type": "text",
      "x": 2022.3898161881448,
      "y": 1611.61408395338,
      "width": 1358.5999755859375,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
