      "isDeleted": true,
      "boundElements": [],
      "updated": 1777820241487,
      "link": null,
      "locked": false,
      "text": "class Persona\n{\nprivate :\n    std :: string m_strNombre ;\n    int m_nEdad ;\n    bool m_bEsVaron ;\n    int m_nId; //NUEVO ATRIBUTO\n\npublic :\n    //AÑADIMOS AL CONSTRUCTOR EL nId\n    Persona ( std :: string strNombre , int nEdad , bool\n    bEsVaron, int nId )\n    : m_strNombre ( strNombre ) , m_nEdad ( nEdad ) ,\n    m_bEsVaron ( bEsVaron ) , m_nId ( nId )\n    {\n    }\n\n    std :: string GetNombre () { return m_strNombre ; }\n    int GetEdad () { return m_nEdad ; }\n    bool EsVaron () { return m_bEsVaron ; }\n    int GetId() { return m_nId ; } //NUEVO MÉTODO\n};\n\nclass Empleado\n{\nprivate :\n    std :: string m_strEmpleador ;\n    double m_dSalario ;\n    int m_nId; //NUEVO ATRIBUTO\n\npublic :\n    //AÑADIMOS AL CONSTRUCTOR EL nId\n    Empleado ( std :: string strEmpleador , double dSalario , int nId )\n    : m_strEmpleador ( strEmpleador ) ,\n    m_dSalario ( dSalario ), m_nId ( nId )\n    {\n    }\n\n    std :: string GetEmpleador () { return m_strEmpleador ; }\n    double GetSalario () { return m_dSalario ; }\n    int GetId() { return m_nId ; } //NUEVO MÉTODO\n};\n\nclass Profesor : public Persona , public Empleado\n{\nprivate :\n    int m_nDictaGrado;\n\npublic :\n    //AÑADIMOS AL CONSTRUCTOR EL nId\n    Profesor ( std :: string strNombre , int nEdad , bool\n    bEsVaron, std :: string strEmpleador , double dSalario ,\n    int nId , int nDictaGrado )\n    : Persona ( strNombre , nEdad , bEsVaron , nId ) ,\n    Empleado ( strEmpleador , dSalario , nId ) ,\n    m_nDictaGrado ( nDictaGrado )\n    {\n    }\n    \n    int nameClash() { return GetId() ; } \n    //ERROR: El compilador no sabe cuál GetId() usar\n};",
      "fontSize": 24.638703676089445,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Persona\n{\nprivate :\n    std :: string m_strNombre ;\n    int m_nEdad ;\n    bool m_bEsVaron ;\n    int m_nId; //NUEVO ATRIBUTO\n\npublic :\n    //AÑADIMOS AL CONSTRUCTOR EL nId\n    Persona ( std :: string strNombre , int nEdad , bool\n    bEsVaron, int nId )\n    : m_strNombre ( strNombre ) , m_nEdad ( nEdad ) ,\n    m_bEsVaron ( bEsVaron ) , m_nId ( nId )\n    {\n    }\n\n    std :: string GetNombre () { return m_strNombre ; }\n    int GetEdad () { return m_nEdad ; }\n    bool EsVaron () { return m_bEsVaron ; }\n    int GetId() { return m_nId ; } //NUEVO MÉTODO\n};\n\nclass Empleado\n{\nprivate :\n    std :: string m_strEmpleador ;\n    double m_dSalario ;\n    int m_nId; //NUEVO ATRIBUTO\n\npublic :\n    //AÑADIMOS AL CONSTRUCTOR EL nId\n    Empleado ( std :: string strEmpleador , double dSalario , int nId )\n    : m_strEmpleador ( strEmpleador ) ,\n    m_dSalario ( dSalario ), m_nId ( nId )\n    {\n    }\n\n    std :: string GetEmpleador () { return m_strEmpleador ; }\n    double GetSalario () { return m_dSalario ; }\n    int GetId() { return m_nId ; } //NUEVO MÉTODO\n};\n\nclass Profesor : public Persona , public Empleado\n{\nprivate :\n    int m_nDictaGrado;\n\npublic :\n    //AÑADIMOS AL CONSTRUCTOR EL nId\n    Profesor ( std :: string strNombre , int nEdad , bool\n    bEsVaron, std :: string strEmpleador , double dSalario ,\n    int nId , int nDictaGrado )\n    : Persona ( strNombre , nEdad , bEsVaron , nId ) ,\n    Empleado ( strEmpleador , dSalario , nId ) ,\n    m_nDictaGrado ( nDictaGrado )\n    {\n    }\n    \n    int nameClash() { return GetId() ; } \n    //ERROR: El compilador no sabe cuál GetId() usar\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
