      "link": null,
      "locked": false,
      "text": "class Persona\n{\n    //Atributos PRIVADOS:\n    private String m_strNombre;\n    private int m_nEdad;\n    private boolean m_bEsVaron;\n    \n    //CONSTRUCTOR Persona:\n    public Persona(String Nombre, int Edad, boolean esVaron){\n        this.m_strNombre = Nombre;\n        this.m_nEdad = Edad;\n        this.m_bEsVaron = esVaron;\n    }\n\n    //MÉTODOS PÚBLICOS:\n    public String GetNombre(){ return m_strNombre; }\n    public int GetEdad(){ return m_nEdad; }\n    public boolean EsVaron(){ return m_bEsVaron; }\n}\n\n//Implementamos Empleado como INTERFAZ para simular multiherencia:\n//Dicha Intefaz define solamente el \"que\", falta implementar el \"como\"\n\ninterface Empleado{\n    public String GetEmpleador();\n    public double GetSalario();\n}\n\n//Creación de Clase PROFESOR que hereda de Persona e implementa la INTERFAZ:\nclass Profesor extends Persona implements Empleado\n{\n    //ATRIBUTOS PRIVADOS propios de Profesor:\n    private int m_nDictaGrado;\n    private String m_strEmpleador;\n    private double m_dSalario;\n\n    //Constructor: Utiliza 'super' para llamar al padre\n    public Profesor(String Nombre, int Edad, boolean esVaron, int Grado, String Empleador, double Salario){\n        super(Nombre, Edad, esVaron); //Llama al Padre: La Clase Persona\n        this.m_nDictaGrado = Grado;\n        this.m_strEmpleador = Empleador;\n        this.m_dSalario = Salario;\n    }\n    \n    @Override\n    public String GetEmpleador(){ return this.m_strEmpleador; }\n\n    @Override\n    public double GetSalario(){ return this.m_dSalario; }\n}",
      "fontSize": 25.666666666666657,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Persona\n{\n    //Atributos PRIVADOS:\n    private String m_strNombre;\n    private int m_nEdad;\n    private boolean m_bEsVaron;\n    \n    //CONSTRUCTOR Persona:\n    public Persona(String Nombre, int Edad, boolean esVaron){\n        this.m_strNombre = Nombre;\n        this.m_nEdad = Edad;\n        this.m_bEsVaron = esVaron;\n    }\n\n    //MÉTODOS PÚBLICOS:\n    public String GetNombre(){ return m_strNombre; }\n    public int GetEdad(){ return m_nEdad; }\n    public boolean EsVaron(){ return m_bEsVaron; }\n}\n\n//Implementamos Empleado como INTERFAZ para simular multiherencia:\n//Dicha Intefaz define solamente el \"que\", falta implementar el \"como\"\n\ninterface Empleado{\n    public String GetEmpleador();\n    public double GetSalario();\n}\n\n//Creación de Clase PROFESOR que hereda de Persona e implementa la INTERFAZ:\nclass Profesor extends Persona implements Empleado\n{\n    //ATRIBUTOS PRIVADOS propios de Profesor:\n    private int m_nDictaGrado;\n    private String m_strEmpleador;\n    private double m_dSalario;\n\n    //Constructor: Utiliza 'super' para llamar al padre\n    public Profesor(String Nombre, int Edad, boolean esVaron, int Grado, String Empleador, double Salario){\n        super(Nombre, Edad, esVaron); //Llama al Padre: La Clase Persona\n        this.m_nDictaGrado = Grado;\n        this.m_strEmpleador = Empleador;\n        this.m_dSalario = Salario;\n    }\n    \n    @Override\n    public String GetEmpleador(){ return this.m_strEmpleador; }\n\n    @Override\n    public double GetSalario(){ return this.m_dSalario; }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
