      "isDeleted": true,
      "boundElements": [],
      "updated": 1777820241488,
      "link": null,
      "locked": false,
      "text": "int notNameClash() { return Persona::GetId() ; }",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
