      "locked": false,
      "text": "1 + $pred(1) = 1 + 0 = 1",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 + $pred(1) = 1 + 0 = 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Q4nX5NuoIDFb5X6dFTynA",
      "type": "text",
      "x": 8120.796469512918,
      "y": 1010.0680238219466,
      "width": 910.5833129882812,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "Kbs88SFv5splxLOeNBtUt",
      "index": "c17b",
      "roundness": null,
      "seed": 1110139186,
      "version": 1326,
      "versionNonce": 1110103342,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775443628759,
      "link": null,
      "locked": false,
      "text": "exception Excpt of int;\nfun twice(f,x) = f(f(x)) handle Excpt (x) => x;\nfun pred(x) = if x = 0 then raise Excpt (x) else x-1;\nfun smart(x) = 1 + pred(x) handle Excpt(x) => 1;\ntwice(smart,1)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "exception Excpt of int;\nfun twice(f,x) = f(f(x)) handle Excpt (x) => x;\nfun pred(x) = if x = 0 then raise Excpt (x) else x-1;\nfun smart(x) = 1 + pred(x) handle Excpt(x) => 1;\ntwice(smart,1)",
      "autoResize": true,
      "lineHeight": 1.25
    },
