      "isDeleted": true,
      "boundElements": [],
      "updated": 1775433234847,
      "link": null,
      "locked": false,
      "text": "declare A=2 B=4 C=1\nproc {P X Y Z}\n  C=5\n  X=Z\n  C=4\n  Y=Z+A\nend\nin {P A B A+C}\n{Browse B}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "declare A=2 B=4 C=1\nproc {P X Y Z}\n  C=5\n  X=Z\n  C=4\n  Y=Z+A\nend\nin {P A B A+C}\n{Browse B}",
