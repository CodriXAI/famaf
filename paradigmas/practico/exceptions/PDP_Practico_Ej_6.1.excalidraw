      "text": "exception Excpt of int;\nfun twice(f,x) = f(f(x)) handle Excpt (x) => x;\nfun dumb(x) = raise Excpt(x);\ntwice(dumb,1)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "exception Excpt of int;\nfun twice(f,x) = f(f(x)) handle Excpt (x) => x;\nfun dumb(x) = raise Excpt(x);\ntwice(dumb,1)",
      "autoResize": true,
      "lineHeight": 1.25
