    {
      "id": "Tlo1a5TzUatXxFYWZ2KUe",
      "type": "text",
      "x": 1506.4724830501616,
      "y": -482.6799527760121,
      "width": 910.5833129882812,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0lY",
      "roundness": null,
      "seed": 1846353842,
      "version": 316,
      "versionNonce": 1991862318,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775442368763,
      "link": null,
      "locked": false,
      "text": "exception Excpt of int;\nfun twice(f,x) = f(f(x)) handle Excpt (x) => x;\nfun pred(x) = if x = 0 then raise Excpt (x) else x-1;\nfun dumb(x) = raise Excpt(x);\nfun smart(x) = 1 + pred(x) handle Excpt(x) => 1;",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "exception Excpt of int;\nfun twice(f,x) = f(f(x)) handle Excpt (x) => x;\nfun pred(x) = if x = 0 then raise Excpt (x) else x-1;\nfun dumb(x) = raise Excpt(x);\nfun smart(x) = 1 + pred(x) handle Excpt(x) => 1;",
      "autoResize": true,
      "lineHeight": 1.25
    },
