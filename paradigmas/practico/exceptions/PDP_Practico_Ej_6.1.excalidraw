    {
      "id": "i1SkgjjXn2bwgjTwv4LaE",
      "type": "text",
      "x": 1422.0450721528546,
      "y": -877.5891681106477,
      "width": 14.399999618530273,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
