    {
      "id": "yExDQko4dBtq-RxTiQ_dY",
      "type": "text",
      "x": 5924.556995366313,
      "y": 4879.109853349062,
      "width": 910.5833129882812,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
