      "type": "text",
      "x": 1338.4812160476467,
      "y": -122.65547110843113,
      "width": 360.1666564941406,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
