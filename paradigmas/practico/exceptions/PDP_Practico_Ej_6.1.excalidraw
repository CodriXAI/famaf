    {
      "id": "o-WbmJO6PwU2JCJh4QsYv",
      "type": "text",
      "x": 3683.556470302244,
      "y": 1087.4423899232331,
      "width": 910.5833129882812,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "Kbs88SFv5splxLOeNBtUt",
      "index": "c0yK",
      "roundness": null,
      "seed": 202868274,
      "version": 902,
      "versionNonce": 2027145326,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775443628716,
      "link": null,
      "locked": false,
      "text": "exception Excpt of int;\nfun twice(f,x) = f(f(x)) handle Excpt (x) => x;\nfun pred(x) = if x = 0 then raise Excpt (x) else x-1;\nfun smart(x) = 1 + pred(x) handle Excpt(x) => 1;\ntwice(smart,1)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "exception Excpt of int;\nfun twice(f,x) = f(f(x)) handle Excpt (x) => x;\nfun pred(x) = if x = 0 then raise Excpt (x) else x-1;\nfun smart(x) = 1 + pred(x) handle Excpt(x) => 1;\ntwice(smart,1)",
      "autoResize": true,
      "lineHeight": 1.25
    },
