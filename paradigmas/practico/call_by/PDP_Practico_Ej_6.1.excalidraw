      "boundElements": [],
      "updated": 1775352813040,
      "link": null,
      "locked": false,
      "text": "global string switch = \"OFF\"\n\nfuntion calcular(x)\nbegin\n    if (interruptor == \"OFF\") then\n        return x * 2;\n    else\n        return 0;\n    end\nend\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "global string switch = \"OFF\"\n\nfuntion calcular(x)\nbegin\n    if (interruptor == \"OFF\") then\n        return x * 2;\n    else\n        return 0;\n    end\nend\n",
      "autoResize": true,
      "lineHeight": 1.25
