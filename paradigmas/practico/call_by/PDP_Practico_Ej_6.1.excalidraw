    {
      "id": "rm7iZ2N7EbAS_qlZ3PxWB",
      "type": "text",
      "x": 1416.0605198602595,
      "y": -378.09313636461684,
      "width": 582.9166870117188,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
