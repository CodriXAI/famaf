      "updated": 1775352813040,
      "link": null,
      "locked": false,
      "text": "global int secondary = 0\n\nfuntion sumar1(x)\nbegin\n    \n    // Efecto secundario:\n    secondary = secondary + 1;\n    \n    // Se mantiene con transparencia referencialmente:\n    return x + 1;\nend\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "global int secondary = 0\n\nfuntion sumar1(x)\nbegin\n    \n    // Efecto secundario:\n    secondary = secondary + 1;\n    \n    // Se mantiene con transparencia referencialmente:\n    return x + 1;\nend\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
