      "seed": 1288708868,
      "version": 717,
      "versionNonce": 1031742852,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772410904072,
      "link": null,
      "locked": false,
      "text": "Definido sobre tiempos de Declaración\nSe referencia al bloque y momento donde\nse declara una variable, función, estructura\nde datos mediante un \"access link\" que guarda\ndicha información.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Definido sobre tiempos de Declaración\nSe referencia al bloque y momento donde\nse declara una variable, función, estructura\nde datos mediante un \"access link\" que guarda\ndicha información.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "w6J6fxBML5B178UgPyJki",
      "type": "text",
      "x": 1304.148645599811,
      "y": 423.2268243399901,
      "width": 848.9500122070312,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHG",
      "roundness": null,
      "seed": 1348280964,
      "version": 1001,
      "versionNonce": 151508228,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772410904072,
      "link": null,
      "locked": false,
      "text": "Definido sobre tiempos de Ejecución\nSe referencia al bloque y momento donde\nse ejecuta una función por ejemplo, y se accede\nmediante la pila recorriendola hasta obtener la\ndeclaración más reciente de una variable global, u\notra función en específico.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Definido sobre tiempos de Ejecución\nSe referencia al bloque y momento donde\nse ejecuta una función por ejemplo, y se accede\nmediante la pila recorriendola hasta obtener la\ndeclaración más reciente de una variable global, u\notra función en específico.",
      "autoResize": true,
      "lineHeight": 1.25
    },
