    {
      "id": "jzMPRs91Grc0qF9FPNp7n",
      "type": "text",
      "x": 331.6545197292926,
      "y": 440.7604486570797,
      "width": 808.4500122070312,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
