      "isDeleted": false,
      "boundElements": [],
      "updated": 1772496145431,
      "link": null,
      "locked": false,
      "text": "function crearContador(paso) {\n    \n    function incrementar(n) { \n        return n + paso; \n    }\n   \n    return incrementar; \n}\n\nconst suma1 = crearContador(1); \nsuma1(5); ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function crearContador(paso) {\n    \n    function incrementar(n) { \n        return n + paso; \n    }\n   \n    return incrementar; \n}\n\nconst suma1 = crearContador(1); \nsuma1(5); ",
      "autoResize": true,
      "lineHeight": 1.25
    },
