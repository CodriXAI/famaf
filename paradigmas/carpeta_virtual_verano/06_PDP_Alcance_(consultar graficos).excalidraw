    },
    {
      "id": "5tgzAqDBexi9QP05xLSqJ",
      "type": "text",
      "x": 2307.4097236153216,
      "y": 306.9418405597985,
      "width": 435.6000061035156,
      "height": 630,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHa",
      "roundness": null,
      "seed": 1609709700,
      "version": 889,
      "versionNonce": 1677372164,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772410904073,
      "link": null,
      "locked": false,
      "text": "main\n   ...\n     val x = 4;\n\n     fun f(y) = x * y;\n\n     fun g(h) = \n       let \n          val x = 7;\n       in\n          h(3) + x;\n\n     g(f);\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "main\n   ...\n     val x = 4;\n\n     fun f(y) = x * y;\n\n     fun g(h) = \n       let \n          val x = 7;\n       in\n          h(3) + x;\n\n     g(f);\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
