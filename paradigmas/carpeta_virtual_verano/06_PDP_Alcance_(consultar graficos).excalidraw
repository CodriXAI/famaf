      "text": "Suponiendo que tenemos el siguiente programa de ejemplo:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Suponiendo que tenemos el siguiente programa de ejemplo:",
