      "isDeleted": false,
      "boundElements": [],
      "updated": 1772496145431,
      "link": null,
      "locked": false,
      "text": "val x = 4;\nfun f(y) = x * y;\nfun g(h) = \n   let \n      val x = 7;\n   in\n      h(3) + x;\ng(f);",
      "fontSize": 36,
      "fontFamily": 8,
