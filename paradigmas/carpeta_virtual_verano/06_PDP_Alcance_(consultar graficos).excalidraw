    {
      "id": "bJs-rIav78U4RphyT60DD",
      "type": "text",
      "x": 2917.7514128960092,
      "y": 3084.8620674465155,
      "width": 633.5999755859375,
      "height": 495,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
