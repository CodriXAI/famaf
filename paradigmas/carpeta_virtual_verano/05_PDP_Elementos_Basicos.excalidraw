      "isDeleted": false,
      "boundElements": [],
      "updated": 1771289968878,
      "link": null,
      "locked": false,
      "text": "En el tipado dinámico, el tipo\ndepende del valor que la variable\nposea en tiempo de ejecución",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En el tipado dinámico, el tipo depende del valor que la variable posea en tiempo de ejecución",
      "autoResize": false,
      "lineHeight": 1.25
    },
