    {
      "id": "iDBZ-s6jQJxgq5DHvwltG",
      "type": "rectangle",
      "x": 4835.754179891766,
      "y": 490.4960761450184,
      "width": 336,
      "height": 69,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
