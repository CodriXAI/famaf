    {
      "id": "qDqUbPJh5QgpZVDWvqtua",
      "type": "text",
      "x": 6314.008381358168,
      "y": 1598.287246023289,
      "width": 1328.566650390625,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
