      "isDeleted": false,
      "boundElements": [],
      "updated": 1771289947278,
      "link": null,
      "locked": false,
      "text": "En el tipado estático, los tipos se\nfijan en tiempo de compilación a\ntravés de declaraciones \nexplícitas.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En el tipado estático, los tipos se fijan en tiempo de compilación a través de declaraciones \nexplícitas.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "mYakE9iyQfsKgUKkvUQGr",
      "type": "text",
      "x": -1347.1220488754286,
      "y": 1523.81146503991,
      "width": 622.449971516927,
      "height": 135,
      "angle": 0,
