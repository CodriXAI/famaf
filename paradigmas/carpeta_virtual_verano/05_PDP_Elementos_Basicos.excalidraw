      "seed": 726401453,
      "version": 82,
      "versionNonce": 2019764621,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769816850739,
      "link": null,
      "locked": false,
      "text": "Un access link es un puntero que, cuando se consulta una variable no local, \nindica en qué entorno léxico (qué bloque activo) debe buscarse esa variable \npara obtener su valor.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un access link es un puntero que, cuando se consulta una variable no local, \nindica en qué entorno léxico (qué bloque activo) debe buscarse esa variable \npara obtener su valor.",
      "autoResize": true,
      "lineHeight": 1.25
    },
