    {
      "id": "977gJpr-rSOIPkFRK8bH1",
      "type": "text",
      "x": 6397.724760299235,
      "y": 388.1200525426186,
      "width": 14.399999618530273,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
