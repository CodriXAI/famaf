      "index": "bBY",
      "roundness": {
        "type": 2
      },
      "seed": 653733561,
      "version": 563,
      "versionNonce": 316605709,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "LnL3La3qan2veeLv3XqKA",
