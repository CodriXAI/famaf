    {
      "id": "SXiu8dEV1wnhWe8BXp34l",
      "type": "ellipse",
      "x": 1482.768644484318,
      "y": -457.98850385966307,
      "width": 542.2262512903098,
      "height": 151.61386311419398,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
