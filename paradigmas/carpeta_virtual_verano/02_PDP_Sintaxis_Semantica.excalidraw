    {
      "id": "Y13oWmFQdkLZ3cLb53BCf",
      "type": "text",
      "x": -376.1655222730601,
      "y": 2699.2343698414484,
      "width": 1110.3333740234375,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
