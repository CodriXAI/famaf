      "x": 2294.9350087985977,
      "y": 1040.2705212710262,
      "width": 1020.9556637552745,
      "height": 256.4556236947539,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
