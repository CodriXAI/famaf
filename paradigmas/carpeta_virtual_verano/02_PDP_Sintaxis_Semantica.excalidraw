    {
      "id": "lx0kMC-aVUDgvH6j4jTUF",
      "type": "text",
      "x": 1024.8479819723366,
      "y": 3097.0442045799014,
      "width": 1013.1500244140625,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
