      "boundElements": [],
      "updated": 1769208890789,
      "link": null,
      "locked": false,
      "text": "V = Vértices\nE = Lados / Aristas\n| V | = Cardinal de V = Cant de elementos (vértices) de V = n\n| E | = Cardinal de V = Cant de elementos (lados) de E = m\n{x, y} ∈ E se escribirá también como xy\n    xy = yx (en términos de conjuntos)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "V = Vértices\nE = Lados / Aristas\n| V | = Cardinal de V = Cant de elementos (vértices) de V = n\n| E | = Cardinal de V = Cant de elementos (lados) de E = m\n{x, y} ∈ E se escribirá también como xy\n    xy = yx (en términos de conjuntos)",
      "autoResize": true,
      "lineHeight": 1.25
    },
