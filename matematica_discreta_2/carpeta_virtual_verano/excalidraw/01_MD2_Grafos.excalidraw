    },
    {
      "id": "0xkiJnQJEVTKucTP2zW2K",
      "type": "text",
      "x": 963.9589538418838,
      "y": -1261.6680194644382,
      "width": 810.9000244140625,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b72",
      "roundness": null,
      "seed": 761658858,
      "version": 184,
      "versionNonce": 1345469719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769208890789,
      "link": null,
      "locked": false,
      "text": "G = (V , E) con:\nV = {A, B, C, D, E} (por lo tanto, n = 5)\nE = {{A, B}, {A, C}, {A, E}, {C, E}} (por lo\ntanto, m = 4)\nO bien, en la notación que usaremos\nusualmente que hemos\naclarado antes, E = {AB, AC, AE, CE}.\n\nNo hay que confundir un grafo con la\nrepresentación gráfica de un\ngrafo.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "G = (V , E) con:\nV = {A, B, C, D, E} (por lo tanto, n = 5)\nE = {{A, B}, {A, C}, {A, E}, {C, E}} (por lo tanto, m = 4)\nO bien, en la notación que usaremos usualmente que hemos\naclarado antes, E = {AB, AC, AE, CE}.\n\nNo hay que confundir un grafo con la representación gráfica de un\ngrafo.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "CkDH66Dv-jP3Ov8B6sxyX",
      "type": "text",
      "x": -293.1517102704548,
      "y": 1166.1018317977428,
      "width": 165.23333740234375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b73",
      "roundness": null,
      "seed": 1689214262,
      "version": 136,
      "versionNonce": 1001473719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769208841825,
      "link": null,
      "locked": false,
      "text": "Subgrafo:",
