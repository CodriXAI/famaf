    {
      "id": "YecxlMGfuQcvRH9wR7-5L",
      "type": "text",
      "x": 1441.6465930205827,
      "y": 1290.6578380809553,
      "width": 1136.816650390625,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
