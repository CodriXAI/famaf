    {
      "id": "vcG0va5e999wN9eOSkJMM",
      "type": "text",
      "x": 6067.041723381553,
      "y": 4429.629136083143,
      "width": 937.1333618164062,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
