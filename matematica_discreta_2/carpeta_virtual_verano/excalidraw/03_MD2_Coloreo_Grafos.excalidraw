    {
      "id": "oGhd9-4HNzCV5dw37FAkk",
      "type": "rectangle",
      "x": 2080.0261717207286,
      "y": 4003.953937740234,
      "width": 501.19047619047683,
      "height": 67.14285714285734,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
