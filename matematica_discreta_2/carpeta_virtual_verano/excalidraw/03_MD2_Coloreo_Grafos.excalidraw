    {
      "id": "CAFJaU7ZHpoXkvbLeS0t2",
      "type": "text",
      "x": 6566.218397624599,
      "y": -651.5609664757168,
      "width": 1285.6500244140625,
      "height": 53.33333333333334,
      "angle": 0,
      "strokeColor": "#9c36b5",
