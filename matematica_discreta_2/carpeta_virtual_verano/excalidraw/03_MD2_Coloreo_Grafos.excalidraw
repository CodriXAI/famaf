      "originalText": "Prueba por contradicción de que: 3 ≤ χ(C2r + 1) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vr912HakN7AREuZkWb2ql",
      "type": "rectangle",
      "x": 8123.969351623219,
      "y": 559.652568648138,
      "width": 860.6964536743826,
