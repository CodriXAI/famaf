      "isDeleted": false,
      "boundElements": null,
      "updated": 1769548983292,
      "link": null,
      "locked": false,
      "text": "Un coloreo es propio si \n\nxy ∈ E ⇒ c(x) ≠ c(y ) \n\n(extremos con distinto color)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un coloreo es propio si \n\nxy ∈ E ⇒ c(x) ≠ c(y ) \n\n(extremos con distinto color)",
      "autoResize": true,
      "lineHeight": 1.25
    },
