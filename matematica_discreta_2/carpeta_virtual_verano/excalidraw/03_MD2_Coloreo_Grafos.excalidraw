      "updated": 1769892525778,
      "link": null,
      "locked": false,
      "text": "¿Qué hacer en caso de no encontrar un subgrafo H adecuado?:",
      "fontSize": 42.66666666666667,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Qué hacer en caso de no encontrar un subgrafo H adecuado?:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Jeug1AooNdjG1pNhG3ujh",
      "type": "ellipse",
      "x": 6539.551730957933,
      "y": -706.5609664757164,
      "width": 1345,
      "height": 165,
      "angle": 0,
      "strokeColor": "#9c36b5",
