    {
      "id": "bfu9rXtq5SO2d4a1p8AZ5",
      "type": "text",
      "x": 1863.9547431492983,
      "y": -933.6214590851632,
      "width": 947.4500122070312,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
