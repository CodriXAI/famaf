    {
      "id": "EJQVHnaPH0N52DKyTcAfd",
      "type": "text",
      "x": 690.0856955302521,
      "y": -14.530189243890959,
      "width": 879.0333251953125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAZ",
      "roundness": null,
      "seed": 14883136,
      "version": 339,
      "versionNonce": 1572610075,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769618549604,
      "link": null,
      "locked": false,
      "text": "Sea G un grafo G = (V,E), Un coloreo es propio si \n\nxy ∈ E(G) ⇒ c(x) ≠ c(y ) \n\n(extremos con distinto color)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea G un grafo G = (V,E), Un coloreo es propio si \n\nxy ∈ E(G) ⇒ c(x) ≠ c(y ) \n\n(extremos con distinto color)",
      "autoResize": true,
      "lineHeight": 1.25
    },
