    {
      "id": "fD7Jtcs76_F0TKbG58sE8",
      "type": "text",
      "x": 5973.088147883972,
      "y": 4103.67675513076,
      "width": 1279.4666748046875,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
