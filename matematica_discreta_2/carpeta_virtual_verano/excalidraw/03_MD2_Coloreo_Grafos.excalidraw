    {
      "id": "uq9uaGsrCahj92f3BvbmH",
      "type": "text",
      "x": 1848.6452193397752,
      "y": -1320.272252735956,
      "width": 900.5833740234376,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
