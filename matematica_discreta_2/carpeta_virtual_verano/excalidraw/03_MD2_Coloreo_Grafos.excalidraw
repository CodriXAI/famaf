      "isDeleted": false,
      "boundElements": null,
      "updated": 1771604193270,
      "link": null,
      "locked": false,
      "text": "Si se puede colorear el grafo con solo dos\ncolores de modo que ningún vecino tenga el mismo color, es bipartito.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si se puede colorear el grafo con solo dos\ncolores de modo que ningún vecino tenga el mismo color, es bipartito.",
      "autoResize": false,
      "lineHeight": 1.25
    },
