      "index": "bAh",
      "roundness": null,
      "seed": 521138496,
      "version": 145,
      "versionNonce": 64520896,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769549012846,
      "link": null,
      "locked": false,
      "text": "Definimos al número cromático del Grafo G como:\n\nχ(G) = min{k : ∃ un coloreo propio con k colores de G}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Definimos al número cromático del Grafo G como:\n\nχ(G) = min{k : ∃ un coloreo propio con k colores de G}",
      "autoResize": true,
      "lineHeight": 1.25
    },
