    {
      "id": "1ckkkcSA8x2WdHtCriWqS",
      "type": "text",
      "x": 5920.0437075085365,
      "y": 5910.025961479978,
      "width": 1313.066650390625,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFs",
      "roundness": null,
      "seed": 1137327238,
      "version": 453,
      "versionNonce": 1442565830,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1771605329876,
      "link": null,
      "locked": false,
      "text": "Notemos que para que esto sea posible, Rojo - Azul - Rojo .....\nComo empezamos desde Rojo, deberemos terminar en Rojo\n\nLuego si el Grafo Cíclico es impar, terminaríamos en el mismo bando, lo \nque rompería la definición de que el grafo sea 2-coloreable. Por lo tanto no\nexiste un Cíclico impar asumiendo que el Grafo sea Bipartito",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Notemos que para que esto sea posible, Rojo - Azul - Rojo .....\nComo empezamos desde Rojo, deberemos terminar en Rojo\n\nLuego si el Grafo Cíclico es impar, terminaríamos en el mismo bando, lo \nque rompería la definición de que el grafo sea 2-coloreable. Por lo tanto no\nexiste un Cíclico impar asumiendo que el Grafo sea Bipartito",
      "autoResize": true,
      "lineHeight": 1.25
    },
