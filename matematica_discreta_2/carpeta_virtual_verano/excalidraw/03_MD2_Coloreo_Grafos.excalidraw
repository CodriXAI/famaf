    {
      "id": "0_hC636B8JFevlv1iCYsI",
      "type": "text",
      "x": 5906.154818619649,
      "y": 3657.010088464095,
      "width": 1472.13330078125,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF9",
      "roundness": null,
      "seed": 2131941210,
      "version": 234,
      "versionNonce": 781890394,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1771604114663,
      "link": null,
      "locked": false,
      "text": "Un Grafo G = (V, E) es bipartito si se puede dividir el conjunto de sus vértices (V) \nen dos grupos distintos, digamos V1​ y V2​, de tal manera que:\n\n    * Ningún vértice se conecte con otro de su mismo grupo.\n\n    * Todas las aristas conecten un vértice de V1​ con uno de V2​.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un Grafo G = (V, E) es bipartito si se puede dividir el conjunto de sus vértices (V) \nen dos grupos distintos, digamos V1​ y V2​, de tal manera que:\n\n    * Ningún vértice se conecte con otro de su mismo grupo.\n\n    * Todas las aristas conecten un vértice de V1​ con uno de V2​.",
      "autoResize": true,
      "lineHeight": 1.25
    },
