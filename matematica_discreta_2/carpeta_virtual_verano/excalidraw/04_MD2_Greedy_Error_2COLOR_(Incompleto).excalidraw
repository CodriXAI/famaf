    },
    {
      "id": "0K5qdW5OWOAPK_tU9-y0y",
      "type": "rectangle",
      "x": -1127.5277024656693,
      "y": -256.2011543587051,
      "width": 547.1428571428578,
      "height": 65.15886915186391,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
