    {
      "id": "g-7CCJCBqY3l8WhPLSUJZ",
      "type": "text",
      "x": 3624.849725641425,
      "y": 2064.0950953763986,
      "width": 1292,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
