    {
      "id": "ArW6d3bebBO_rqWo-MLsf",
      "type": "rectangle",
      "x": -874.7896072275742,
      "y": -1023.6297257872766,
      "width": 465.7142857142858,
      "height": 97.14285714285711,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
