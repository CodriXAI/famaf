      "text": "VIT (Very Important Theorem)",
      "fontSize": 65.71428571428554,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "VIT (Very Important Theorem)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5-7EhqgGpHrKUaPaDkzjW",
      "type": "rectangle",
      "x": 2062.988170550202,
      "y": -1077.5781384856898,
      "width": 1049.8809523809527,
      "height": 117.14285714285734,
