      "text": "Ejemplo Grafo Bipartito",
      "fontSize": 44.07805854390784,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ejemplo Grafo Bipartito",
