      "link": null,
      "locked": false
    },
    {
      "id": "oQB2Ezu5a4rgBXyf9Um8m",
      "type": "text",
      "x": 1444.5830552009763,
      "y": 1858.3877504420336,
      "width": 1418.449951171875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOc",
      "roundness": null,
      "seed": 1672034691,
      "version": 380,
      "versionNonce": 899660973,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1775178210504,
      "link": null,
      "locked": false,
      "text": "Sin el concepto de Vecinos Anteriores y Posteriores, el Algoritmo sería\nplenamente Greedy, siendo incapaz de poder volver atrás, cancelar caminos\npara dar lugar a otros mejores. Y si bien nos podría dar un flujo, no precisamente\nsería flujo maximal.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sin el concepto de Vecinos Anteriores y Posteriores, el Algoritmo sería\nplenamente Greedy, siendo incapaz de poder volver atrás, cancelar caminos\npara dar lugar a otros mejores. Y si bien nos podría dar un flujo, no precisamente\nsería flujo maximal.",
      "autoResize": true,
      "lineHeight": 1.25
    },
