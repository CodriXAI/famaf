      "locked": false,
      "text": "¿Cómo utilizamos el concepto de Vecinos Posteriores / Anteriores?",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Cómo utilizamos el concepto de Vecinos Posteriores / Anteriores?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MTx10aacNrIXMOzF_M04b",
      "type": "rectangle",
      "x": 1438.5461775562133,
      "y": 1760.1984200143208,
      "width": 1190.9817988302539,
      "height": 66.52100272736106,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOb",
      "roundness": {
        "type": 3
      },
      "seed": 772526339,
      "version": 149,
      "versionNonce": 1216055555,
      "isDeleted": true,
      "boundElements": null,
