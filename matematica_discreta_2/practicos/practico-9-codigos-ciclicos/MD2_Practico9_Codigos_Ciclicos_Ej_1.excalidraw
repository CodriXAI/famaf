    {
      "id": "pk6DYVh9GXE-X1uX_3YgK",
      "type": "text",
      "x": 1451.9114231076053,
      "y": 2155.2365518581532,
      "width": 833.4666748046875,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2ye",
