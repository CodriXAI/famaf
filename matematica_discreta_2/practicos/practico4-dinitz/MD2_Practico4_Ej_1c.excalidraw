    {
      "id": "2bj1wCBK6sfro_8hkIH59",
      "type": "text",
      "x": 5896.500807561782,
      "y": 1018.534839318334,
      "width": 910.5833129882812,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c13E",
      "roundness": null,
      "seed": 945729390,
      "version": 1177,
      "versionNonce": 426654697,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1775516346622,
      "link": null,
      "locked": false,
      "text": "exception Excpt of int;\nfun twice(f,x) = f(f(x)) handle Excpt (x) => x;\nfun pred(x) = if x = 0 then raise Excpt (x) else x-1;\nfun smart(x) = 1 + pred(x) handle Excpt(x) => 1;\ntwice(smart,1)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "exception Excpt of int;\nfun twice(f,x) = f(f(x)) handle Excpt (x) => x;\nfun pred(x) = if x = 0 then raise Excpt (x) else x-1;\nfun smart(x) = 1 + pred(x) handle Excpt(x) => 1;\ntwice(smart,1)",
      "autoResize": true,
      "lineHeight": 1.25
    },
