      "link": null,
      "locked": false,
      "text": "var x = 1;\nfunction g(z) {return x+z;}\nfunction f(y) {\n   var x = y+1;\n   return g(y*x);\n}\nf(3)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "var x = 1;\nfunction g(z) {return x+z;}\nfunction f(y) {\n   var x = y+1;\n   return g(y*x);\n}\nf(3)",
      "autoResize": true,
      "lineHeight": 1.25
