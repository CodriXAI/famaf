    {
      "id": "xvCwTnQQTGUXjB9p0zeJS",
      "type": "text",
      "x": 1407.2627229543252,
      "y": -943.1458694887707,
      "width": 829.566650390625,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1kD",
      "roundness": null,
      "seed": 1635336046,
      "version": 456,
      "versionNonce": 634671342,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775760714119,
      "link": null,
      "locked": false,
      "text": "\n\nVértices\nn = 3r \nque son: xi,zi,yi donde i = 1,...,r\n\nx1 = s\nxr = t\n\nLados: \n    xi xi+1, con c(xi xi+1) = r² para todo i < r - 1\n    xr-1 zj con c(xr-1 zj) = r² para todo j\n    zj yk con c(zj yk) = 1 para todo j,k \n    yk t con c(yk t) = r² para todo k",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nVértices\nn = 3r \nque son: xi,zi,yi donde i = 1,...,r\n\nx1 = s\nxr = t\n\nLados: \n    xi xi+1, con c(xi xi+1) = r² para todo i < r - 1\n    xr-1 zj con c(xr-1 zj) = r² para todo j\n    zj yk con c(zj yk) = 1 para todo j,k \n    yk t con c(yk t) = r² para todo k",
      "autoResize": true,
      "lineHeight": 1.25
    },
