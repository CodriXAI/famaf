    {
      "id": "-2J5eRXYEqB14mHgVEFUw",
      "type": "text",
      "x": 1381.9952126744179,
      "y": -963.2676493010888,
      "width": 1267.4000244140625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1kP",
      "roundness": null,
      "seed": 557212082,
      "version": 16,
