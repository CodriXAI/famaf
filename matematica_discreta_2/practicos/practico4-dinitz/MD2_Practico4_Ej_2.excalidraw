      "isDeleted": false,
      "boundElements": null,
      "updated": 1775763259850,
      "link": null,
      "locked": false,
      "text": "Cálculo de \"Esfuerzo\" u Orden de complejidad:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cálculo de \"Esfuerzo\" u Orden de complejidad:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zfa9_HHHvWu5pONKb88-_",
      "type": "rectangle",
      "x": 1396.224589024192,
      "y": 2422.6267123790217,
      "width": 819.9997101011124,
      "height": 78.68684086828853,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
