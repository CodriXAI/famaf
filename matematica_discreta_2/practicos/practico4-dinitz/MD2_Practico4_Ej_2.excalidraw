    {
      "id": "b_jjfIhvPIZM9i-rOD7S5",
      "type": "text",
      "x": 1397.4376935276484,
      "y": -189.94884543312367,
      "width": 1189.7166748046875,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
