      "version": 219,
      "versionNonce": 1095036910,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775763788588,
      "link": null,
      "locked": false,
      "text": "Pasar a la siguiente Network repitiendo el BFS hasta que\nno se pueda llegar a t",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pasar a la siguiente Network repitiendo el BFS hasta que\nno se pueda llegar a t",
      "autoResize": true,
      "lineHeight": 1.25
    },
