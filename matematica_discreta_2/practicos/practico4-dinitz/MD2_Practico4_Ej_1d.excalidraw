    {
      "id": "IuU7w9uOs0e0kh9n0-DYV",
      "type": "text",
      "x": 1318.5119159799372,
      "y": 4476.648944207891,
      "width": 1453.5833740234375,
      "height": 225,
      "angle": 0,
