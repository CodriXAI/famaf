      "seed": 1539247564,
      "version": 359,
      "versionNonce": 1709411341,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775710869807,
      "link": null,
      "locked": false,
      "text": "Corte S = {s,w,q,v,r,x,z,u,y,p,g,m,f,l,e,k,d,j,c}\n\ncap(S) = c(xt) + c(zt) + c(pa) + c(pb) + c(gn) + c(mt) + c(lt) + c(kt) + c(jt) + c(ci)\n         = 60 + 100 + 20 + 20 + 10 + 20 + 20 + 20 + 20 + 10\n         = 300",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Corte S = {s,w,q,v,r,x,z,u,y,p,g,m,f,l,e,k,d,j,c}\n\ncap(S) = c(xt) + c(zt) + c(pa) + c(pb) + c(gn) + c(mt) + c(lt) + c(kt) + c(jt) + c(ci)\n         = 60 + 100 + 20 + 20 + 10 + 20 + 20 + 20 + 20 + 10\n         = 300",
      "autoResize": true,
      "lineHeight": 1.25
    },
