    {
      "id": "H8vJFg8Q5MEClvco4nME1",
      "type": "text",
      "x": 802.4606228167813,
      "y": -548.0208106001761,
      "width": 469.6333312988281,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
