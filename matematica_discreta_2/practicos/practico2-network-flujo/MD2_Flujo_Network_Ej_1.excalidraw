    },
    {
      "id": "o2BIOkOMp4qCy68SpxGpw",
      "type": "rectangle",
      "x": 1356.0891221346506,
      "y": 1917.2545770822992,
      "width": 541.9707040199446,
      "height": 82.77370752304591,
