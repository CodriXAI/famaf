    {
      "id": "DH-f_6y46I9A-tpRHiPOS",
      "type": "text",
      "x": 3325.3558330336973,
      "y": -153.89734209555547,
      "width": 1373.2166748046875,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
