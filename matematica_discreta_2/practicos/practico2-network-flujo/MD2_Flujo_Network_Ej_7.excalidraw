      "index": "bY4",
      "roundness": null,
      "seed": 1090071663,
      "version": 404,
      "versionNonce": 1018905743,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774833838732,
      "link": null,
      "locked": false,
      "text": "Hipótesis Inductiva (HI): Asumimos que luego de k aumentos en el camino, tendremos\nun fk flujo luego de k aumentos tal que fk(xy) es par para todo xy lado en el camino",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hipótesis Inductiva (HI): Asumimos que luego de k aumentos en el camino, tendremos\nun fk flujo luego de k aumentos tal que fk(xy) es par para todo xy lado en el camino",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MB6KoeNhUvnsFZezjgQ64",
      "type": "rectangle",
      "x": -340.18830279256645,
      "y": 336.12056137317984,
      "width": 1506.2842566656714,
      "height": 111.39722798492096,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
