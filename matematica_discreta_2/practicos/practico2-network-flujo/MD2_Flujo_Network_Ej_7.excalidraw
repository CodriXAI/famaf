    {
      "id": "M7J8IH592Gatydgc8kRgP",
      "type": "text",
      "x": -330.02749708950205,
      "y": 344.29516038352045,
      "width": 1485,
      "height": 90,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
