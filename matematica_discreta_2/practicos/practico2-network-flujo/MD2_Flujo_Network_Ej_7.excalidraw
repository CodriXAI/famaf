      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En este caso, tendríamos múltiples \nlados repetidos que forman xy",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "o_qet3Hv18nHE-nlXBfsR",
      "type": "text",
      "x": 2897.082164383931,
      "y": 2268.7396023595793,
      "width": 921.2666625976562,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
