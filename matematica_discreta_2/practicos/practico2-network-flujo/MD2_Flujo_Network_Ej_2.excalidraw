    {
      "id": "3safVCCVYjbGpuaY7MxF6",
      "type": "text",
      "x": 2175.746512640015,
      "y": -473.8862746107179,
      "width": 1240.199951171875,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
