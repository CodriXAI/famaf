    {
      "id": "hsUj5ndAO8m5LctLdSkFV",
      "type": "text",
      "x": 1265.9052281681372,
      "y": -1047.07129036802,
      "width": 1615.7332763671875,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
