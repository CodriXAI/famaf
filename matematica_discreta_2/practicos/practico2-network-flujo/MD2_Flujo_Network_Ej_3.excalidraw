      "isDeleted": false,
      "boundElements": [],
      "updated": 1774575115163,
      "link": null,
      "locked": false,
      "text": "¿Qué hacer? Conservar solo uno de los tantos\nlados múltiples y sumar las capacidades restantes\npara tener el equivalente de varios lados en uno solo",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
