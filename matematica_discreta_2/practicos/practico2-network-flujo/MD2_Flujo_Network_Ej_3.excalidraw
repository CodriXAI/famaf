      "isDeleted": false,
      "boundElements": [],
      "updated": 1774575115163,
      "link": null,
      "locked": false,
      "text": "De esta forma, la caja negra solo verá un solo lado,\nlo cuál le basta para poder efectuar el cálculo del Max\nFlow de la Network",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "De esta forma, la caja negra solo verá un solo lado,\nlo cuál le basta para poder efectuar el cálculo del Max\nFlow de la Network",
      "autoResize": true,
      "lineHeight": 1.25
    },
