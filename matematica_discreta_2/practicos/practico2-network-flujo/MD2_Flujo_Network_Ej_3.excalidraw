    {
      "id": "WgTJ1OXK9va8jDZOdCFaI",
      "type": "text",
      "x": 1292.0225733481218,
      "y": -715.3529477335562,
      "width": 1416.316650390625,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
