    {
      "id": "EJQVHnaPH0N52DKyTcAfd",
      "type": "text",
      "x": 690.0856955302521,
      "y": -14.530189243890959,
      "width": 879.0333251953125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
