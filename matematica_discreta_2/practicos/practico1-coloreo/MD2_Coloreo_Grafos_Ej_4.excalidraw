    {
      "id": "oGhd9-4HNzCV5dw37FAkk",
      "type": "rectangle",
      "x": 2416.6928383873956,
      "y": 3213.9539377402334,
      "width": 501.19047619047683,
      "height": 67.14285714285734,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
