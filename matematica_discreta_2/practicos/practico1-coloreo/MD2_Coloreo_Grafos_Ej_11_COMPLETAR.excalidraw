      "boundElements": [],
      "updated": 1773341546490,
      "link": null,
      "locked": false,
      "text": "Esta guía tiene como propósito el tener una referencia sobre como encarar los ejercicios\npara el comienzo de la cursada, con ejemplos y explicando el por qué de cada paso ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Esta guía tiene como propósito el tener una referencia sobre como encarar los ejercicios\npara el comienzo de la cursada, con ejemplos y explicando el por qué de cada paso ",
      "autoResize": true,
      "lineHeight": 1.25
    },
