      "name": "Tablero 5x5 con coordenadas"
    },
    {
      "id": "SeRUO1LBP1DZQTW0qiy_S",
      "type": "text",
      "x": 8740.677637670822,
      "y": 3757.9905493327774,
      "width": 1020.7333374023438,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bmH",
      "roundness": null,
      "seed": 1255327564,
      "version": 447,
      "versionNonce": 1185350004,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774410862731,
      "link": null,
      "locked": false,
      "text": "Ejemplo con las Filas (algunas):\n1ra Fila:\n    0 mod 5 = 0\n=> 0 ≡ 0 (mod 5)\n2da Fila (+2):\n    2 mod 5 = 2\n=> 2 ≡ 2 (mod 5)\n3ra Fila (+2):\n    4 mod 5 = 4\n=> 4 ≡ 4 (mod 5)\n4ta Fila (+2):\n    6 mod 5 = 1 pues 5 * 1 +1 = 6\n=> 6 ≡ 1 (mod 5) => 6 está a la \"misma altura reloj\" que 1\n5ta Fila (+2):\n    8 mod 5 = 3 pues 5 * 1 + 3 = 8\n=> 8 ≡ 3 (mod 5) => 8 está a la \"misma altura reloj\" que 3",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ejemplo con las Filas (algunas):\n1ra Fila:\n    0 mod 5 = 0\n=> 0 ≡ 0 (mod 5)\n2da Fila (+2):\n    2 mod 5 = 2\n=> 2 ≡ 2 (mod 5)\n3ra Fila (+2):\n    4 mod 5 = 4\n=> 4 ≡ 4 (mod 5)\n4ta Fila (+2):\n    6 mod 5 = 1 pues 5 * 1 +1 = 6\n=> 6 ≡ 1 (mod 5) => 6 está a la \"misma altura reloj\" que 1\n5ta Fila (+2):\n    8 mod 5 = 3 pues 5 * 1 + 3 = 8\n=> 8 ≡ 3 (mod 5) => 8 está a la \"misma altura reloj\" que 3",
      "autoResize": true,
      "lineHeight": 1.25
    },
