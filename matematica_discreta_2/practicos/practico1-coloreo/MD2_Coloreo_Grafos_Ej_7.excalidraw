      "updated": 1773842549051,
      "link": null,
      "locked": false,
      "text": "Luego al colorear p con un 4to color, obtenemos el mínimo coloreo propio posible, haciendo que:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Luego al colorear p con un 4to color, obtenemos el mínimo coloreo propio posible, haciendo que:",
      "autoResize": true,
      "lineHeight": 1.25
    },
