    },
    {
      "id": "EKX5RWA-KLbm_uPsTvThd",
      "type": "text",
      "x": 4148.932756159261,
      "y": -805.3170764472686,
      "width": 1620.2667236328125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
