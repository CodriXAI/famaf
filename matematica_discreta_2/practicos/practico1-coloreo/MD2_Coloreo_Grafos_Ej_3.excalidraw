    {
      "id": "3Kzge5TRVJl7AP4exQqVI",
      "type": "rectangle",
      "x": 2418.686015005954,
      "y": 4097.609764252988,
      "width": 248.66666666666714,
      "height": 59.33333333333395,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
