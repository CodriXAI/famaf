      "updated": 1773792283804,
      "link": null,
      "locked": false,
      "text": "Grafo de Petersen (sin colorear):\n\n* Podemos observar a simple vista que es un Grafo Regular,\n  en particular, 3-regular.\n",
      "fontSize": 36.176451748884475,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Grafo de Petersen (sin colorear):\n\n* Podemos observar a simple vista que es un Grafo Regular,\n  en particular, 3-regular.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
