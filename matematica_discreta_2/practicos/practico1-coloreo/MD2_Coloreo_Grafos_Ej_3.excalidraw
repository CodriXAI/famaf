    {
      "id": "fURHeUh38Vzbd6GgQ3NmK",
      "type": "text",
      "x": 6609.204487479055,
      "y": 464.2252437902306,
      "width": 1139.3357973451991,
      "height": 56.666666666666785,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
