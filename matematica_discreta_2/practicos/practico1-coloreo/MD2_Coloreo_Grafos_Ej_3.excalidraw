    {
      "id": "Uelgbxy3M0OV5na02vlnI",
      "type": "text",
      "x": 683.8079177524747,
      "y": -1314.371459085161,
      "width": 1058.2500406901042,
      "height": 1080,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
