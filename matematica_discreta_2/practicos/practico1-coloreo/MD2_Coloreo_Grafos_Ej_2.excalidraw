    {
      "id": "pxZRZD6JYk1l1rpcd25hc",
      "type": "text",
      "x": 894.8419306313974,
      "y": 401.43628212869163,
      "width": 1302.7667236328125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
