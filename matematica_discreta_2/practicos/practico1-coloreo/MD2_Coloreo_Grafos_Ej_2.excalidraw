    },
    {
      "id": "pCRdr93ESPhcPtFcjtC_E",
      "type": "text",
      "x": 1015.8071420656395,
      "y": -794.5401636968052,
      "width": 1295.2833251953125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOC",
      "roundness": null,
      "seed": 1107392531,
      "version": 462,
      "versionNonce": 1427822899,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773788423839,
      "link": null,
      "locked": false,
      "text": "Sea v un vértice del Grafo Completo Kn. Tenemos que calcular la altura de\nlos árboles de DFS y BFS de Kn con raíz en v ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea v un vértice del Grafo Completo Kn. Tenemos que calcular la altura de\nlos árboles de DFS y BFS de Kn con raíz en v ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lAW3BxWPtUtaMvfmNh4fS",
      "type": "text",
      "x": 937.192250457209,
      "y": -41.401851323457834,
      "width": 176.73333740234375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOD",
      "roundness": null,
      "seed": 1962390451,
      "version": 1039,
      "versionNonce": 186402099,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773787538253,
      "link": null,
      "locked": false,
      "text": "Para DFS:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Para DFS:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9wZ0uAzyE2Bo5pg54Zzqi",
      "type": "rectangle",
      "x": 920.2624844834365,
      "y": -50.54867672028337,
