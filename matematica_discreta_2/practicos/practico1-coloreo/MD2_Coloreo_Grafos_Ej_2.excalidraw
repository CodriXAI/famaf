    },
    {
      "id": "o3X9iLLZTqftcrVS5teCu",
      "type": "text",
      "x": 2427.310403496253,
      "y": 5181.524200548107,
      "width": 1163.0167236328125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bSA",
      "roundness": null,
      "seed": 550730131,
      "version": 407,
      "versionNonce": 7771411,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773790344061,
      "link": null,
      "locked": false,
      "text": "(Donde L(v) y L'(v) significa \"Last\" o \"Último vértice\" respecto a v\ncomo en el caso impar tenemos 2 Last, por ello se utiliza L prima)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(Donde L(v) y L'(v) significa \"Last\" o \"Último vértice\" respecto a v\ncomo en el caso impar tenemos 2 Last, por ello se utiliza L prima)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-gM_pC8sRNhna3mel59SB",
      "type": "text",
      "x": 2432.251726343356,
      "y": 5289.857901565394,
      "width": 1130.550048828125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bSB",
      "roundness": null,
      "seed": 104835581,
      "version": 662,
      "versionNonce": 229145267,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773790344061,
      "link": null,
      "locked": false,
      "text": "(En el caso impar, además, se ajusta la altura a n-1, pues sino\nno da una cantidad entera de altura, y como L y L' pertenecen al\nmismo último nivel, entonces es válido)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(En el caso impar, además, se ajusta la altura a n-1, pues sino\nno da una cantidad entera de altura, y como L y L' pertenecen al\nmismo último nivel, entonces es válido)",
      "autoResize": true,
      "lineHeight": 1.25
    },
