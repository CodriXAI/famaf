      "isDeleted": false,
      "boundElements": [],
      "updated": 1773788552122,
      "link": null,
      "locked": false,
      "text": "Sea v un vértice del Grafo Cíclico Cn. Tenemos que calcular la altura de\nlos árboles de DFS y BFS de Cn con raíz en v ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea v un vértice del Grafo Cíclico Cn. Tenemos que calcular la altura de\nlos árboles de DFS y BFS de Cn con raíz en v ",
      "autoResize": true,
      "lineHeight": 1.25
    },
