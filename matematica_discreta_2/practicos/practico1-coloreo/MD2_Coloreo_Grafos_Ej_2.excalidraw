    {
      "id": "eqWQAaxZBZO6Ukb7ptAWz",
      "type": "text",
      "x": 2233.838771845206,
      "y": 18.273741896078604,
      "width": 1046.4000244140625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
