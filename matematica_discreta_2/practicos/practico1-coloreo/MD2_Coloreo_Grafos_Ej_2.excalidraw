    {
      "id": "y-esxums0u8PVndtvB3CA",
      "type": "text",
      "x": 791.4725975330937,
      "y": 2014.6681882907924,
      "width": 1215.7332763671875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
