      "text": "¿Es G Grafo Conexo?",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Es G Grafo Conexo?",
