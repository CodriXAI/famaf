    {
      "id": "UprTqTCxzRYw4b5dUuMpv",
      "type": "text",
      "x": 3642.192057169361,
      "y": 692.9507391406946,
      "width": 1346.566650390625,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
