    {
      "id": "TuOl7iLPbGTWhQtRTH6Be",
      "type": "text",
      "x": 2709.487004106185,
      "y": 798.5704543035225,
      "width": 703.277828876101,
      "height": 810,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
