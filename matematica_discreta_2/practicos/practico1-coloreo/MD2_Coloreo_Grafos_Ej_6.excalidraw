      "text": "Caso que u,v > 1 (y son compuestos):",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Caso que u,v > 1 (y son compuestos):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hJ4UGVdwbQCZ3aR745f8g",
      "type": "rectangle",
      "x": 4137.799080564936,
      "y": 2159.7975974328433,
      "width": 673.5654798688746,
      "height": 82,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bRi",
      "roundness": {
        "type": 3
      },
      "seed": 20955049,
      "version": 168,
      "versionNonce": 1633146345,
      "isDeleted": false,
