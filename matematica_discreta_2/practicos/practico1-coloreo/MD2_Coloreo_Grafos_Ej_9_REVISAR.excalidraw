    {
      "id": "ANnmdPw2D4ut6gomZ_7GQ",
      "type": "text",
      "x": 3328.8603508469173,
      "y": 803.0811133645959,
      "width": 1628.183349609375,
      "height": 585,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
