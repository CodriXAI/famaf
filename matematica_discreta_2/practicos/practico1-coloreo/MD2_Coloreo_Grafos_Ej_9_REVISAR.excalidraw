    {
      "id": "60wpw2SrBXppdEkVYfvkc",
      "type": "text",
      "x": 4383.835376718333,
      "y": -965.3784710225675,
      "width": 468.20001220703125,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
