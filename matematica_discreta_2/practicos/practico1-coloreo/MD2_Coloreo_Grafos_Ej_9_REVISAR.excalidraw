      "seed": 751246338,
      "version": 1986,
      "versionNonce": 1773858370,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1773845932364,
      "link": null,
      "locked": false,
      "text": "Luego, como exhibimos un coloreo de 3 colores => χ(Mr) <= 3, luego por tener de subgrafo a un Ciclico\nimpar entonces:\n\n3 <= χ(Mr) <= 3 = χ(Mr) = 3 \n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Luego, como exhibimos un coloreo de 3 colores => χ(Mr) <= 3, luego por tener de subgrafo a un Ciclico\nimpar entonces:\n\n3 <= χ(Mr) <= 3 = χ(Mr) = 3 \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
