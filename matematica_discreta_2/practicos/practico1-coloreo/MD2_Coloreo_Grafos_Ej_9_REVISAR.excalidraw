    {
      "id": "FIKM8wy53zlNynS8zOZvc",
      "type": "text",
      "x": 4274.881009095831,
      "y": 935.427084532991,
      "width": 1022.8333129882812,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
