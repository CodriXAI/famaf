      "versionNonce": 1956876034,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773846208011,
      "link": null,
      "locked": false,
      "text": "Tenemos un Grafo G con:\n* 18 vértices con Grado 1\n* 25 vértices con Grado 2\n* 10 vértices con Grado 3\n* 15 vértices con Grado 4\n* 27 vértices con Grado 5\n* 19 vértices con Grado 8\n* 3 vértices con Grado 9\n* 4 vértices con Grado 15\n* 1 vértice con Grado 34\n* 1 vértice con Grado 36",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tenemos un Grafo G con:\n* 18 vértices con Grado 1\n* 25 vértices con Grado 2\n* 10 vértices con Grado 3\n* 15 vértices con Grado 4\n* 27 vértices con Grado 5\n* 19 vértices con Grado 8\n* 3 vértices con Grado 9\n* 4 vértices con Grado 15\n* 1 vértice con Grado 34\n* 1 vértice con Grado 36",
      "autoResize": true,
      "lineHeight": 1.25
    },
