    {
      "id": "00E059GVLLc_xBed9isZ9",
      "type": "text",
      "x": 4250.948469413295,
      "y": 82.0024813583878,
      "width": 1587.2833251953125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
