    {
      "id": "BnDGwViX9YvQq7vNaKzAH",
      "type": "text",
      "x": 3287.8969637819105,
      "y": -656.3248420855004,
      "width": 903.75,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
