    {
      "id": "XcPgnfKhvMp1tCBQumJ4Y",
      "type": "text",
      "x": 5240.394036339374,
      "y": 3629.855882683981,
      "width": 1777.550048828125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
