    {
      "id": "i55pIDqOeN9G1QNUU4Gsg",
      "type": "text",
      "x": 4244.86633062516,
      "y": 321.6532750091813,
      "width": 1484.2166748046875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
