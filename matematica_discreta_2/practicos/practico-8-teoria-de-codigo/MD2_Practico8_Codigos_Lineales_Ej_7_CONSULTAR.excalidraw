      "updated": 1779395125653,
      "link": null,
      "locked": false,
      "text": "Por ejemplo algunas de las palabras en el Código son:",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por ejemplo algunas de las palabras en el Código son:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4x8sTnZmNkhkq7BQy4bXE",
      "type": "text",
      "x": 1445.8006191793606,
      "y": 1423.1609782380517,
      "width": 574.2000122070312,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2u4",
      "roundness": null,
      "seed": 1771342800,
      "version": 120,
      "versionNonce": 592335824,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1779395125653,
      "link": null,
      "locked": false,
      "text": "00000000 -> Palabra Nula de C\n11011000 -> G1\n01010100 -> G2\n10001100 -> G1 + G2",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "00000000 -> Palabra Nula de C\n11011000 -> G1\n01010100 -> G2\n10001100 -> G1 + G2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KDoQEx5fWv3GczNJUxi6f",
      "type": "text",
      "x": 1924.725373004636,
      "y": 1174.5211454815687,
      "width": 1167.8333740234375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2u5",
      "roundness": null,
      "seed": 272257488,
      "version": 147,
      "versionNonce": 1045270832,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1779395125653,
      "link": null,
      "locked": false,
      "text": "(La otra forma era: Como H : [I | A], tendríamos\nque G : [A^t | I] por teorema y ahí sacabamos las palabras)",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(La otra forma era: Como H : [I | A], tendríamos\nque G : [A^t | I] por teorema y ahí sacabamos las palabras)",
      "autoResize": true,
      "lineHeight": 1.25
    },
