      "isDeleted": true,
      "boundElements": [],
      "updated": 1779144037120,
      "link": null,
      "locked": false,
      "text": "Restamos m en la zona verde\nSumamos m en las zonas doble tachadas\nEl resto, nada",
      "fontSize": 36,
