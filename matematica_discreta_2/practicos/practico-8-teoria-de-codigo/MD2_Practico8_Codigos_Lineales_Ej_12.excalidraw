      "link": null,
      "locked": false,
      "text": "Luego, no hay columna nula pero SI REPETIDAS => δ(C) <= 2 (se niega δ(C) >= 3)  ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Luego, no hay columna nula pero SI REPETIDAS => δ(C) <= 2 (se niega δ(C) >= 3)  ",
