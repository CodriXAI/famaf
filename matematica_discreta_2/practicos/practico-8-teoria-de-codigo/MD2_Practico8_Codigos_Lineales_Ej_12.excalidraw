      "text": "Un millón de palabras equivalen a 10⁶ palabras y necesitamos corregir \n1 error",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un millón de palabras equivalen a 10⁶ palabras y necesitamos corregir \n1 error",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2gQ1H75zjRxkrITRqaKw4",
      "type": "text",
      "x": 1346.9589539514354,
      "y": -784.6686311884669,
      "width": 1287,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
