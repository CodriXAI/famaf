      "text": "Por definición de δ(C) en Códigos Lineales =>\n\n    δ(C) : {min |v| : v en C ^ v != 0} ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por definición de δ(C) en Códigos Lineales =>\n\n    δ(C) : {min |v| : v en C ^ v != 0} ",
      "autoResize": true,
      "lineHeight": 1.25
    },
