      "isDeleted": true,
      "boundElements": [],
      "updated": 1779150285929,
      "link": null,
      "locked": false,
      "text": "En este caso k = 6, ya que k = 7 daría más y me pasaría\nPor lo tanto la cota del Código Lineal\nSería #C <= 2⁶ = 64",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En este caso k = 6, ya que k = 7 daría más y me pasaría\nPor lo tanto la cota del Código Lineal\nSería #C <= 2⁶ = 64",
      "autoResize": true,
      "lineHeight": 1.25
    },
