      "link": null,
      "locked": false,
      "text": ": Se conectan a los literales de la disyunción específica Dj que estemos viendo\ncomo son 3 literales SI O SI, tendremos 3 extremos de la garra, van en orden\nde izquierda a derecha",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": ": Se conectan a los literales de la disyunción específica Dj que estemos viendo\ncomo son 3 literales SI O SI, tendremos 3 extremos de la garra, van en orden\nde izquierda a derecha",
      "autoResize": true,
      "lineHeight": 1.25
    },
