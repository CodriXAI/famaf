    {
      "id": "fVf9vV47HCMWUjvLpXd-D",
      "type": "text",
      "x": 2340.6949803240204,
      "y": 1150.7658185224477,
      "width": 1274.0999755859375,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "528J5opXj5NDGGn5rJN-u",
      "index": "bDcV",
      "roundness": null,
      "seed": 1137104035,
      "version": 2041,
      "versionNonce": 370150083,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783027468940,
      "link": null,
      "locked": false,
      "text": ": El detector de ABSURDOS, o de verificación en caso de ser correcto.\nSi la instancia B NO ES VERDADERA \n=> Todas las literales de la Dj son Falsas\n=> Como se falsifique una Dj, se falsifica TODA la conjunción.\nSi nos centramos solo en los literales de una Dj, por definición de la prueba, si todos los\nvi involucrados en el Dj son FALSOS \n=> Ningún vértice \"v\" puede tener el color de UNO\n=> Como están conectados a DOS, tampoco pueden tener el color de DOS\n=> Solo pueden tener el \"Tercer Color\"\n=> Los \"e's\", al estar conectados con UNO y los literales, solo pueden usar el color de DOS\n=> Como los \"e's\" se conectan al triangulo de las \"a's\" => Las \"a's\" solo pueden usar 2 colores:\nel de UNO o el \"Tercer Color\", como forman un triangulo, NO se puede colorear, ABSURDO",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": ": El detector de ABSURDOS, o de verificación en caso de ser correcto.\nSi la instancia B NO ES VERDADERA \n=> Todas las literales de la Dj son Falsas\n=> Como se falsifique una Dj, se falsifica TODA la conjunción.\nSi nos centramos solo en los literales de una Dj, por definición de la prueba, si todos los\nvi involucrados en el Dj son FALSOS \n=> Ningún vértice \"v\" puede tener el color de UNO\n=> Como están conectados a DOS, tampoco pueden tener el color de DOS\n=> Solo pueden tener el \"Tercer Color\"\n=> Los \"e's\", al estar conectados con UNO y los literales, solo pueden usar el color de DOS\n=> Como los \"e's\" se conectan al triangulo de las \"a's\" => Las \"a's\" solo pueden usar 2 colores:\nel de UNO o el \"Tercer Color\", como forman un triangulo, NO se puede colorear, ABSURDO",
      "autoResize": true,
      "lineHeight": 1.25
    },
