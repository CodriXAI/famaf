    {
      "id": "mbXaS6YZ22KNDxU23uxcx",
      "type": "text",
      "x": 2748.590641851063,
      "y": 1873.0988572965236,
      "width": 870.8333129882812,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
