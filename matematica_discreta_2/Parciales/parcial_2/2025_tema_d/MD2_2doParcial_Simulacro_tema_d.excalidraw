    {
      "id": "aNiveT7I1Ur7cwhFK3A1c",
      "type": "text",
      "x": 3975.0787809538083,
      "y": 1817.9692845732695,
      "width": 1801.433349609375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
