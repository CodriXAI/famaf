      "text": "k = 23 - gr(g) = 23 - 11 = 12\n\n=> Cantidad de Palabras de C es 2¹² = 4096 palabras",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "k = 23 - gr(g) = 23 - 11 = 12\n\n=> Cantidad de Palabras de C es 2¹² = 4096 palabras",
      "autoResize": true,
      "lineHeight": 1.25
    },
