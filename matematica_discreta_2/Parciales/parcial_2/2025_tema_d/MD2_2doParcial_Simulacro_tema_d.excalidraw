      "boundElements": [],
      "updated": 1780600794547,
      "link": null,
      "locked": false,
      "text": "a = q(40.100.000) => Como es par, mod 2 = 0 => a = 0\nb = q(Cifras de las Decenas) => En este caso es 0 (2do) => 0 mod 2 = 0\nc = q(Cifras de las Centenas) => En este caso es 0 (3ro) => 0 mod 2 = 0\nd = q(DNI+1) => q(40.100.001) => Como es impar, mod 2 = 1 => d = 1",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a = q(40.100.000) => Como es par, mod 2 = 0 => a = 0\nb = q(Cifras de las Decenas) => En este caso es 0 (2do) => 0 mod 2 = 0\nc = q(Cifras de las Centenas) => En este caso es 0 (3ro) => 0 mod 2 = 0\nd = q(DNI+1) => q(40.100.001) => Como es impar, mod 2 = 1 => d = 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
