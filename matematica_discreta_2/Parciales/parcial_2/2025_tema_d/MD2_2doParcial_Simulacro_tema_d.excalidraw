      "seed": 1397584076,
      "version": 257,
      "versionNonce": 312504308,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780600179971,
      "link": null,
      "locked": false,
      "text": "Tomamos el mínimo de la zona verde:\n\n* Restamos el mínimo en el conjunto verde\n* Sumamos el mínimo en la doble intersección\n* Lo que esté tachado una vez se conserva\n\nMin zona verde = 1",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tomamos el mínimo de la zona verde:\n\n* Restamos el mínimo en el conjunto verde\n* Sumamos el mínimo en la doble intersección\n* Lo que esté tachado una vez se conserva\n\nMin zona verde = 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
