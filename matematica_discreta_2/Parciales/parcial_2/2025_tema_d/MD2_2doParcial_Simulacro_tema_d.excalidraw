      "boundElements": [],
      "updated": 1780601614822,
      "link": null,
      "locked": false,
      "text": "Luego, como dim(C) = 4 => #Palabras de C = 2⁴ = 16 Palabras",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Luego, como dim(C) = 4 => #Palabras de C = 2⁴ = 16 Palabras",
      "autoResize": true,
      "lineHeight": 1.25
    },
