      "isDeleted": true,
      "boundElements": [],
      "updated": 1776880604422,
      "link": null,
      "locked": false,
      "text": "A -> B C E H I\nB -> A C D G H\nC -> A B D E\nD -> B C E F G\nE -> A C D F I\nF -> D E G I\nG -> B D F H I\nH -> A B G I\nI -> A E F G H\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A -> B C E H I\nB -> A C D G H\nC -> A B D E\nD -> B C E F G\nE -> A C D F I\nF -> D E G I\nG -> B D F H I\nH -> A B G I\nI -> A E F G H\n",
