      "seed": 148420006,
      "version": 100,
      "versionNonce": 339229616,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776913323596,
      "link": null,
      "locked": false,
      "text": "Luego tenemos por Teorema de Max Flow / Min Cut que:",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Luego tenemos por Teorema de Max Flow / Min Cut que:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qGA0L_C8FnY67EylumMrY",
      "type": "text",
      "x": -137.75907882068645,
      "y": 6291.829867338589,
      "width": 774.1166381835938,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c27i",
      "roundness": null,
      "seed": 1605908710,
      "version": 137,
      "versionNonce": 1930773936,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776913323596,
      "link": null,
      "locked": false,
      "text": "v(f) = f(sA) + f(sB) + f(sC) + f(sE) + f(sP)\n      = 79 + 78 + 19 + 70 + 19\n      = 265",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "v(f) = f(sA) + f(sB) + f(sC) + f(sE) + f(sP)\n      = 79 + 78 + 19 + 70 + 19\n      = 265",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qSLG2ajEE5VxBIl3m_3Ws",
      "type": "text",
      "x": 747.0118051860627,
      "y": 6287.805952973651,
      "width": 1106.5167236328125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c27j",
      "roundness": null,
      "seed": 2112267706,
      "version": 195,
      "versionNonce": 1170280368,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776913323597,
      "link": null,
      "locked": false,
      "text": "Además, cap(S) = c(sE) + c(sP) + c(Ht) + c(Mt) + c(It) + c(Ft)\n                   = 70 + 19 + 8 + 90 + 8 + 70\n                   = 265",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Además, cap(S) = c(sE) + c(sP) + c(Ht) + c(Mt) + c(It) + c(Ft)\n                   = 70 + 19 + 8 + 90 + 8 + 70\n                   = 265",
      "autoResize": true,
      "lineHeight": 1.25
    },
