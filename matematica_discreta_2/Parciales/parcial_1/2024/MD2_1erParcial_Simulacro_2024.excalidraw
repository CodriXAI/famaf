    {
      "id": "DlzkzlD2ohDwwa_V3CrVv",
      "type": "text",
      "x": 3427.6826967809857,
      "y": 2430.999329387516,
      "width": 351.6833190917969,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Dr",
      "roundness": null,
      "seed": 1296050608,
      "version": 52,
      "versionNonce": 253035952,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776916836677,
      "link": null,
      "locked": false,
      "text": "v(f) = f(sA) + f(sB)\n      = 15 + 9\n      = 24",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "v(f) = f(sA) + f(sB)\n      = 15 + 9\n      = 24",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4BojXnHhGdFooy4fj6SgU",
      "type": "text",
      "x": 3928.9675170582495,
      "y": 2420.243824906668,
      "width": 697.3833618164062,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Ds",
      "roundness": null,
      "seed": 1497146288,
      "version": 110,
      "versionNonce": 1276783536,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776916911565,
      "link": null,
      "locked": false,
      "text": "Además: caP(S) = c(Et) + c(Ft) + c(Gt)\n                    = 9 + 8 + 7\n                    = 24",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Además: caP(S) = c(Et) + c(Ft) + c(Gt)\n                    = 9 + 8 + 7\n                    = 24",
      "autoResize": true,
      "lineHeight": 1.25
    },
