      "isDeleted": false,
      "boundElements": null,
      "updated": 1776913323596,
      "link": null,
      "locked": false,
      "text": "No podemos llegar a t, Fin de Algoritmo Dinitz\n => Llegamos al corte S : {s,B,C,H,D,J,M,K,L,I,A,F}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No podemos llegar a t, Fin de Algoritmo Dinitz\n => Llegamos al corte S : {s,B,C,H,D,J,M,K,L,I,A,F}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WS5piUlNxvLiG00C6SgJI",
      "type": "text",
      "x": -140.9077036619292,
      "y": 6188.6327539507565,
      "width": 984.3499755859375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
