    {
      "id": "6AkAMOzUJk7mw6-trSrcA",
      "type": "text",
      "x": 1980.6354399271374,
      "y": -1221.6668093855058,
      "width": 1283.4666748046875,
      "height": 360,
      "angle": 0,
