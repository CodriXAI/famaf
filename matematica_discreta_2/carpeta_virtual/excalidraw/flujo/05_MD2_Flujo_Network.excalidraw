    },
    {
      "id": "WMF2ooMy5CGPwWYImGB0u",
      "type": "text",
      "x": 1385.1658059361996,
      "y": -95.92243601661346,
      "width": 1456.38330078125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAh",
      "roundness": null,
      "seed": 527477113,
      "version": 264,
      "versionNonce": 1246319033,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774464620856,
      "link": null,
      "locked": false,
      "text": "Para poder solucionar este problema, primero vamos a establecer definiciones tanto\npara las redes de transporte como para el \"flujo\" de bienes a través de dicha red",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Para poder solucionar este problema, primero vamos a establecer definiciones tanto\npara las redes de transporte como para el \"flujo\" de bienes a través de dicha red",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "neLziU5jTdLbmGdJQ0AWt",
      "type": "arrow",
      "x": 2099.6230332834975,
      "y": 34.36956465101878,
