      "text": "Por descarte entonces, tendremos que c(v2i+1) = i",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por descarte entonces, tendremos que c(v2i+1) = i",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LJB47oeQ-tYLZ0S8DbojG",
      "type": "text",
      "x": -1118.931925583443,
