      "versionNonce": 1048049721,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774467660380,
      "link": null,
      "locked": false,
      "text": "Un ejemplo:\n\n    Dada una variable x, queremos sumar f(x) función para todas las x que\n    satisfagan [P(x)], sin la notación se escribiría de la forma: ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un ejemplo:\n\n    Dada una variable x, queremos sumar f(x) función para todas las x que\n    satisfagan [P(x)], sin la notación se escribiría de la forma: ",
      "autoResize": true,
      "lineHeight": 1.25
    },
