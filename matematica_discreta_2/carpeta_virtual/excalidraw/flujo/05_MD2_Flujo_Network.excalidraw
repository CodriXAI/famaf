    {
      "id": "h4OT5MLqvgGcqdd-luVJq",
      "type": "text",
      "x": 3121.8416652297296,
      "y": 7516.31525997641,
      "width": 1537.11669921875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
