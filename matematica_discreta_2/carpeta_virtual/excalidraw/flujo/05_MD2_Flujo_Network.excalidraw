      "boundElements": [],
      "updated": 1774468266487,
      "link": null,
      "locked": false,
      "text": "Sea g(xy) una función (puede ser para capacidad como para flujo),\npodremos extender la definición en grupos de vértices en vez de \nsolo 2 vértices individuales, de esta forma abarcamos más terreno.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea g(xy) una función (puede ser para capacidad como para flujo),\npodremos extender la definición en grupos de vértices en vez de \nsolo 2 vértices individuales, de esta forma abarcamos más terreno.",
      "autoResize": true,
      "lineHeight": 1.25
    },
