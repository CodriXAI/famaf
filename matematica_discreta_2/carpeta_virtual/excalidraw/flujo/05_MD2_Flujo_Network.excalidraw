      "boundElements": null,
      "updated": 1774467355155,
      "link": null,
      "locked": false,
      "text": "* Los transportadores (vértices intermedios) NO consumirán ni producirán bienes\n* Solo será permitido por los consumidores, más no producirán nuevos\n* Los productores solo producen, más no consumen",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Los transportadores (vértices intermedios) NO consumirán ni producirán bienes\n* Solo será permitido por los consumidores, más no producirán nuevos\n* Los productores solo producen, más no consumen",
      "autoResize": true,
      "lineHeight": 1.25
    },
