    {
      "id": "2H19Q8oIHNL3YwVKSOPHs",
      "type": "text",
      "x": 837.9003140363534,
      "y": 4413.97239916276,
      "width": 1245.9166259765625,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCS",
      "roundness": null,
      "seed": 1174596057,
      "version": 533,
      "versionNonce": 210323577,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774466690759,
      "link": null,
      "locked": false,
      "text": "Observación: \nLos Productores, Consumidores y Transportadores se pueden definir \ntanto aquí en Network como en Flujo, pero en esta ocasión estarán \ndefinido en el flujo de bienes. Pero en pocas palabras:\n\n    * Los productores no reciben nada, sino que \"arrojan\" bienes\n    * Los consumidores no \"arrojan\" bienes, sino que reciben\n    * Los transportadores solo hacen de traspaso, no pueden filtrar ni \n      generar nuevos bienes de la nada",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Observación: \nLos Productores, Consumidores y Transportadores se pueden definir \ntanto aquí en Network como en Flujo, pero en esta ocasión estarán \ndefinido en el flujo de bienes. Pero en pocas palabras:\n\n    * Los productores no reciben nada, sino que \"arrojan\" bienes\n    * Los consumidores no \"arrojan\" bienes, sino que reciben\n    * Los transportadores solo hacen de traspaso, no pueden filtrar ni \n      generar nuevos bienes de la nada",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "L4Au_6OE1nYsnPq6zU0OA",
      "type": "rectangle",
      "x": 825.9189676895985,
      "y": 4397.921620144568,
      "width": 1271.294177472667,
      "height": 459.62174108627187,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
