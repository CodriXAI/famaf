      "versionNonce": 1005335415,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1774463499776,
      "link": null,
      "locked": false,
      "text": "Por otro lado veamos el caso de v2i+2 = v2(i+1) osea el otro lado de la moneda",
      "fontSize": 36,
