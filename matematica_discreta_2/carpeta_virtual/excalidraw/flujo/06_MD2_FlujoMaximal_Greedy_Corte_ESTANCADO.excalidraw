      "text": "Ahora consideraremos el siguiente ejemplo:",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ahora consideraremos el siguiente ejemplo:",
