      "text": "Sea f flujo en un Network N, tal que v(f) = c({s}, V) \n=> f es flujo maximal   ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sea f flujo en un Network N, tal que v(f) = c({s}, V) \n=> f es flujo maximal   ",
      "autoResize": true,
      "lineHeight": 1.25
    },
