    {
      "id": "EwFLKA0Zzeo61zGSdJpZu",
      "type": "text",
      "x": -1117.1779257228668,
      "y": 2351.8320185017024,
      "width": 1452.63330078125,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
