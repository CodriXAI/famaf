      "versionNonce": 1012705967,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772580519316,
      "link": null,
      "locked": false,
      "text": "Por otro lado veamos el caso de v2i+2 = v2(i+1) osea el otro lado de la moneda",
      "fontSize": 36,
