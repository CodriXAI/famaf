    {
      "id": "VdvH0CliKelOAShtmmA8b",
      "type": "rectangle",
      "x": 784.7500753121083,
      "y": -1067.9868686444192,
      "width": 907.3809523809527,
      "height": 117.14285714285734,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
